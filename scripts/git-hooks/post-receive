#!/usr/bin/env bash
# post-receive: maintain the per-branch high-water ref that pre-receive's
# force-push guard checks. Only for agent pushes (CODING_CAVE_AGENT_ID set);
# the user's pushes don't move it.
set -uo pipefail

[ -n "${CODING_CAVE_AGENT_ID:-}" ] || exit 0
zero=0000000000000000000000000000000000000000

# The name is kept rather than dropped: git's format is "<old> <new> <ref>",
# and reading it back as three named fields is what makes the next line
# obviously about the right one. This hook only records where the branch
# ended up, so the old value has nothing to say to it.
# shellcheck disable=SC2034  # `old` documents git's format; only `new` is used
while read -r old new ref; do
  case "$ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  branch=${ref#refs/heads/}
  tip="refs/cav/agent-tip/$branch"
  if [ "$new" = "$zero" ]; then
    git update-ref -d "$tip" 2>/dev/null || true
  else
    git update-ref "$tip" "$new" 2>/dev/null || true
  fi
done
exit 0

#!/usr/bin/env bash
# pre-receive: branch protection for the host repo git-daemon serves to the
# guest VM (see ../vmcav).
#
# Agent identity is CODING_CAVE_AGENT_ID, injected by the daemon (never sent
# by the client), so it is unforgeable from inside the sandbox and the check
# runs on the host, outside it. Empty id means the user, who is exempt: the
# approve/merge flow runs as the user and must be able to move base branches.
#
# For an agent with id N:
#   - may push only to branch refs (refs/heads/*), not tags/notes/replace
#   - may not push any branch whose name contains HEAD (a known bug trap)
#   - may push only within its own namespace, agent-N/<base>
#   - may not push a base branch (main, ...); work waits there for approval
#   - fast-forwards its own branch freely; a non-ff (force/rebase) is allowed
#     only over history it itself pushed (agent-tip == old), so it cannot
#     clobber the user's changes
#   - may delete its own agent-N/* branch (cleanup); a delete skips the
#     force-push guard
# Until per-agent sockets exist, one guest shares one identity, so this gates
# by namespace, not by distinguishing co-resident agents.
set -uo pipefail

zero=0000000000000000000000000000000000000000
agent=${CODING_CAVE_AGENT_ID:-}
status=0
reject() { echo "pre-receive: REJECTED: $*" >&2; status=1; }

# A push that reached this repo through the daemon carries this, whatever it
# claims about which agent made it.
#
# Without it, "no id" has two meanings that cannot be told apart: the human,
# whose approve flow runs here and must be able to move a base branch, and a
# guest push whose id went missing. They are the same empty string, and the
# exemption is granted to whoever it is -- so an id that is ever unset does
# not weaken the gate, it removes it, silently, in the direction of letting
# the guest move base branches. That is the single thing the approval flow
# exists to prevent, so it is worth not resting on a variable being non-empty
# somewhere else in another program.
#
# Refused before any ref is read: nothing about the push matters once it is
# unattributable.
if [ -n "${CODING_CAVE_FROM_GUEST:-}" ] && [ -z "$agent" ]; then
  echo "pre-receive: REJECTED: this push came from the guest with no agent id;" >&2
  echo "  refusing it rather than treating it as the user's" >&2
  exit 1
fi

is_ancestor() { git merge-base --is-ancestor "$1" "$2" 2>/dev/null; }
agent_tip() { git rev-parse --verify --quiet "refs/cav/agent-tip/$1"; }

while read -r old new ref; do
  [ -n "$ref" ] || continue

  # Only branch refs are pushable by agents.
  case "$ref" in
    refs/heads/*) ;;
    *)
      if [ -n "$agent" ]; then
        reject "agent $agent cannot push to '$ref'; agents may only push to branch refs"
      fi
      continue
      ;;
  esac
  branch=${ref#refs/heads/}

  # A branch named ...HEAD... is always a bug (for user and agent alike).
  case "$branch" in
    *HEAD*) reject "branch '$branch' contains HEAD (this is a bug)"; continue ;;
  esac

  # The user (no injected id) is unrestricted below here.
  [ -n "$agent" ] || continue

  case "$branch" in
    agent-*/*)
      rest=${branch#agent-}
      n=${rest%%/*}
      # The namespace has to be a real one, but it does not have to be the
      # stamped agent's.
      #
      # It used to have to be, and that quietly broke every agent but one. A
      # guest holds several agents and every one of their pushes arrives on
      # the same socket, so the id the daemon injects is a fact about the
      # guest and not about whoever pushed: it is fixed when the daemon
      # starts, before any agent exists. Comparing it to the branch therefore
      # rejected agent 2 for not being agent 0 -- and since committing is what
      # publishes here, that left every non-root agent's work stranded in the
      # VM with no way out.
      #
      # So this checks what the host can actually know. Within one VM,
      # attribution is a label rather than a guarantee, exactly as
      # docs/vm-cave-todo.md has it: the worst a wrong id buys is writing into
      # another agent's branch namespace inside the same guest, and agents
      # there are colleagues rather than strangers. What is unaffected is the
      # gate that matters -- a base branch is still refused below, whatever id
      # is claimed, so nothing reaches a human's branch without approval.
      #
      # The check that per-agent separation needs lives in the guest, where
      # the answer is known: cave-git refuses to push outside the pushing
      # agent's own namespace. Making that unforgeable rather than merely
      # correct needs cave-guestd to stamp each connection from the peer's
      # uid, which is the demux design in docs/vm-cave-todo.md.
      case "$n" in
        "" | *[!0-9]*)
          reject "'$branch' is not an agent namespace; expected agent-<id>/<base>"
          continue
          ;;
      esac
      # Non-fast-forward guard, skipped for deletes (new = zero).
      if [ "$old" != "$zero" ] && [ "$new" != "$zero" ] && ! is_ancestor "$old" "$new"; then
        tip=$(agent_tip "$branch") || tip=""
        # The tip has to say this history is the agent's. A missing one used
        # to allow the overwrite, which is the opposite of the rule three
        # lines of comment above state: "allowed only over history it itself
        # pushed". No record is not a record that says yes.
        #
        # A branch can exist here with no tip. post-receive writes it on an
        # agent's push, and nothing else does -- so a branch that arrived any
        # other way has none, and the way that happens is ordinary: the shared
        # repo is cloned from the human's checkout, which carries whatever
        # agent-* branches they have. Those are the human's commits, and they
        # were the ones this guard would have let go.
        #
        # A first push is unaffected: old is zero there and this whole branch
        # is skipped. An agent that has genuinely lost its tip can still
        # delete the branch and push it again, which is two steps rather than
        # a wall.
        if [ -z "$tip" ] || [ "$tip" != "$old" ]; then
          reject "agent $agent force-push would overwrite commits on '$branch' not pushed by this agent; pull the user's changes first"
          continue
        fi
      fi
      ;;
    *)
      reject "agent $agent cannot push to base branch '$branch'; work stays on your dev branch until the user approves it"
      ;;
  esac
done

exit "$status"

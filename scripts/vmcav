#!/usr/bin/env bash
# vmcav: manual lifecycle for the cave-guest VM.
#
#   vmcav [agent]           attach to the agent's claude session (default)
#   vmcav start             build + launch the VM detached (idempotent)
#   vmcav stop              ACPI power-down (SIGTERM/SIGKILL fallback)
#   vmcav status            report up/down
#   vmcav shell [cmd...]    ssh into the guest (no cmd -> interactive shell)
#
# The VM is long-running: `start` detaches it (new session) so it survives the
# shell, and returns. Shutdown is manual via `stop`. Bootstrap-era shell;
# migrates into the Go cave-vm binary later (see ../docs/vm-cave-design.md).
set -euo pipefail

# Resolve through symlinks so vmcav works when linked onto PATH (e.g.
# ~/.local/bin/vmcav -> repo/scripts/vmcav); it builds the repo's guest flake,
# so it must find the repo relative to its real location. Override with REPO=.
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
REPO="${REPO:-$(cd "$(dirname "$SELF")/.." && pwd)}"
# The guest spec is agent-owned (cattle-not-pets: the qcow is a cache, the
# spec ref is the truth). Build from the agent's branch, not the host working
# tree, so the root agent deploys config changes by pushing -- pre-receive
# already permits fast-forwards under refs/heads/agent-*/** and nothing else,
# so the human's own branches stay out of reach. Set CAVE_GUEST_REF to build
# a different ref, or CAVE_GUEST_WORKTREE=1 to use the host checkout (e.g.
# when iterating on the guest config host-side before the agent exists).
CAVE_GUEST_REF="${CAVE_GUEST_REF:-agent-1/vm-cave}"
if [ -n "${CAVE_GUEST_WORKTREE:-}" ]; then
  GUEST_FLAKE="$REPO/guest"
else
  GUEST_FLAKE="git+file://$REPO?ref=refs/heads/$CAVE_GUEST_REF&dir=guest"
fi
CONFIG="${CODING_CAVE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/coding-cave/config.toml}"
STATE_DIR="${STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/coding-cave/vm}"
CRINJ_PORT="${CRINJ_PORT:-10255}"
GIT_PORT="${GIT_PORT:-9418}"

DISK="$STATE_DIR/cave-guest.raw"
SEEDIMG="$STATE_DIR/cave-seed.raw"
CONSOLE="$STATE_DIR/console.log"
PIDFILE="$STATE_DIR/vm.pid"
SEED="$STATE_DIR/cave-host"
SSHKEY="$STATE_DIR/agent_ssh_key"
GITPID="$STATE_DIR/git-daemon.pid"
BRIDGEPIDS="$STATE_DIR/bridges.pid"
# AF_UNIX sun_path is 108 bytes, so keep the CHV control sockets short by
# hashing the state dir rather than nesting under it. VSOCK is the service
# plane: guest-initiated port N appears as ${VSOCK}_N, host-initiated
# connections go to $VSOCK with a "CONNECT <port>" handshake.
SOCKBASE="/tmp/vmcav-$(id -u)-$(printf '%s' "$STATE_DIR" | cksum | cut -d' ' -f1)"
API="$SOCKBASE.api"
VSOCK="$SOCKBASE.vsock"
GUEST_CID="${GUEST_CID:-3}"

log() { printf '[vmcav] %s\n' "$*" >&2; }

# Max disk size in MiB, from config.toml (default 100 GB). Sparse, so the cap
# is elastic; it consumes only what the guest writes.
config_disk_mb() {
  python3 - "$CONFIG" <<'PY'
import sys, os, tomllib
p = sys.argv[1]; cfg = {}
if os.path.exists(p):
    with open(p, "rb") as f: cfg = tomllib.load(f)
print(int(cfg.get("vm", {}).get("disk_size_gb", 100)) * 1024)
PY
}

vm_pid() { [ -f "$PIDFILE" ] && cat "$PIDFILE" 2>/dev/null || true; }
is_running() { local p; p=$(vm_pid); [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

# vmcav's tools come from the dev shell (flake.nix devShell). Fail early with
# guidance rather than silently running degraded. cloud-hypervisor is KVM-only,
# so do_start also checks /dev/kvm before launching.
require_tools() {
  local missing="" t
  for t in setsid ssh-keygen socat git python3 cloud-hypervisor ch-remote mke2fs gpg; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  done
  [ -z "$missing" ] && return
  log "missing tools:$missing"
  log "enter the dev shell first:  nix develop $REPO   (or 'use flake' in .envrc)"
  exit 1
}

# The seed reaches the guest as a small read-only ext4 disk on /dev/vdb. CHV
# has no 9p and its virtio-fs needs a virtiofsd the launcher would have to
# supervise, which is far more machinery than a few static files deserve.
# `mke2fs -d` populates a filesystem from a directory with no mount and no
# root, so this stays inside the rootless footprint.
build_seed_image() {
  rm -f "$SEEDIMG"
  mke2fs -q -t ext4 -d "$SEED" -b 1024 "$SEEDIMG" 65536
}

# Stage host-specific runtime files into the seed dir, which build_seed_image
# turns into the read-only /dev/vdb disk. The crinj CA is
# mandatory: it is baked into the guest's system trust store at build time
# (security.pki), so a missing CA is a hard error, not a warning, else the
# build throws with a less obvious message.
stage_seed() {
  mkdir -p "$SEED"
  local ca=""
  # /etc/crinj-ca.pem is where a container cave mounts its own CA, so this
  # also works when vmcav runs nested inside one.
  for c in "$HOME/.crinj/gateway/ca.pem" \
           "${XDG_DATA_HOME:-$HOME/.local/share}/crinj/gateway/ca.pem" \
           "/etc/crinj-ca.pem"; do
    [ -f "$c" ] && { ca="$c"; break; }
  done
  [ -n "$ca" ] || { log "crinj CA not found (looked in ~/.crinj/gateway/ and"; \
    log "  \$XDG_DATA_HOME/crinj/gateway/); start crinj first"; exit 1; }
  cp -f "$ca" "$SEED/ca.pem"
  [ -f "$HOME/.claude.json" ] && cp -f "$HOME/.claude.json" "$SEED/claude.json" || true
  [ -f "$SSHKEY" ] || ssh-keygen -t ed25519 -N '' -f "$SSHKEY" -C vmcav >/dev/null
  cp -f "$SSHKEY.pub" "$SEED/authorized_keys"
  stage_pubring
  stage_gitconfig
}

# The agent has to commit before it can push, and git refuses to commit
# without an identity. Carry the host's, the same way the Rust implementation
# gives container caves the host's identity, rather than inventing one. Only
# user.name/user.email are copied, not the whole host gitconfig, which
# routinely carries signing keys, credential helpers, and includes that name
# host paths meaningless inside the guest. Absent identity is not fatal here:
# the guest unit falls back so a boot still yields a usable agent.
stage_gitconfig() {
  local name email
  name=$(git config --global user.name 2>/dev/null || true)
  email=$(git config --global user.email 2>/dev/null || true)
  SIGNING_KEY=$(git config --global user.signingkey 2>/dev/null || true)
  local sign; sign=$(git config --global commit.gpgsign 2>/dev/null || true)
  if [ -z "$name" ] && [ -z "$email" ]; then
    rm -f "$SEED/gitconfig"
    log "warning: no global git user.name/user.email; guest will use a fallback identity"
    return
  fi
  { echo "[user]"
    [ -n "$name" ]  && printf '\tname = %s\n' "$name"
    [ -n "$email" ] && printf '\temail = %s\n' "$email"
    # Signing is safe to carry across because the guest's gpg.program is the
    # shim, so this only decides *whether* to sign; the key itself never
    # leaves the host. Carrying it matters: unsigned agent commits were a
    # known disaster for container caves.
    [ -n "$SIGNING_KEY" ] && printf '\tsigningkey = %s\n' "$SIGNING_KEY"
    [ "$sign" = "true" ] && printf '[commit]\n\tgpgsign = true\n'
  } > "$SEED/gitconfig"
}

# Public keyring only, for in-guest verification. Secret key material stays
# here; the guest reaches it solely through the broker, one operation at a
# time, and never as a key.
stage_pubring() {
  local hd; hd=$(gpgconf --list-dirs homedir 2>/dev/null || echo "$HOME/.gnupg")
  [ -f "$hd/pubring.kbx" ] && cp -f "$hd/pubring.kbx" "$SEED/pubring.kbx" || true
}

start_git_daemon() {
  local parent; parent=$(dirname "$REPO")
  # Install both committed hooks fresh every start, so the guard tracks the
  # repo (can't drift from what's reviewed) and no stale hook lingers. This
  # is what makes --enable=receive-pack safe against the human's own live
  # checkout. pre-receive enforces the agent-branch rules; post-receive
  # maintains the agent-tip high-water refs its force-push guard reads.
  install -m 755 "$REPO/scripts/git-hooks/pre-receive"  "$REPO/.git/hooks/pre-receive"
  install -m 755 "$REPO/scripts/git-hooks/post-receive" "$REPO/.git/hooks/post-receive"
  pgrep -f "git daemon.*--base-path=$parent" >/dev/null 2>&1 && return
  # Inject the guest's agent identity into the daemon: git-daemon's
  # receive-pack children and their hooks inherit this env, so the hook reads
  # an id the sandbox cannot forge. Every agent gets a normal number (the
  # registry issues from 1); root is a separate property, not a reserved id.
  # One guest today = one identity; AGENT_ID is a placeholder until vmcav
  # draws it from the cave-vm registry, and per-agent daemons/ports arrive
  # with the multi-agent work.
  CODING_CAVE_AGENT_ID="${AGENT_ID:-1}" \
  git daemon --reuseaddr --export-all --enable=upload-pack --enable=receive-pack \
    --base-path="$parent" --port="$GIT_PORT" --detach --pid-file="$GITPID" "$parent"
  log "git daemon serving $parent on :$GIT_PORT (agent ${AGENT_ID:-1}; hooks pre/post-receive)"
}
stop_git_daemon() { [ -f "$GITPID" ] && { kill "$(cat "$GITPID")" 2>/dev/null || true; rm -f "$GITPID"; }; }

# Host-side leg of the service plane. CHV's hybrid vsock turns a guest
# connection to port N into a connection to the unix socket ${VSOCK}_N, so the
# host has to be listening there. Each bridge just relays to the real service
# on the host. CRINJ_ADDR is overridable because crinj is not always on
# loopback (inside a cave it lives at the gateway address).
CRINJ_ADDR="${CRINJ_ADDR:-127.0.0.1:$CRINJ_PORT}"

start_bridges() {
  stop_bridges
  : > "$BRIDGEPIDS"
  local spec
  for spec in "7200 $CRINJ_ADDR" "7300 127.0.0.1:$GIT_PORT"; do
    set -- $spec
    rm -f "${VSOCK}_$1"
    socat "UNIX-LISTEN:${VSOCK}_$1,fork,unlink-early" "TCP:$2" &
    echo $! >> "$BRIDGEPIDS"
  done
  # The signing broker is its own unix-socket server, so it binds the vsock
  # path directly instead of being relayed through socat. It is the only
  # channel by which the guest can reach the host's key, and it exposes one
  # operation rather than the gpg-agent protocol.
  rm -f "${VSOCK}_7400"
  CAVE_SIGNING_KEY="${SIGNING_KEY:-}" \
    python3 "$REPO/scripts/gpg-broker.py" "${VSOCK}_7400" \
    >> "$STATE_DIR/gpg-broker.log" 2>&1 &
  echo $! >> "$BRIDGEPIDS"
  log "vsock bridges up (7200 -> $CRINJ_ADDR, 7300 -> 127.0.0.1:$GIT_PORT, 7400 -> gpg broker)"
}

stop_bridges() {
  [ -f "$BRIDGEPIDS" ] || return 0
  local p; while read -r p; do kill "$p" 2>/dev/null || true; done < "$BRIDGEPIDS"
  rm -f "$BRIDGEPIDS" "${VSOCK}_7200" "${VSOCK}_7300" "${VSOCK}_7400"
}

crinj_reachable() { (exec 3<>"/dev/tcp/${CRINJ_ADDR%:*}/${CRINJ_ADDR##*:}") 2>/dev/null; }

# ssh ProxyCommand. Host-initiated vsock connections go to $VSOCK and open
# with a "CONNECT <port>" line that CHV answers "OK <n>"; after that the
# stream is the guest's port. Becomes `cave-vm vsock-connect` in the Go CLI.
do_vsock_connect() {
  exec python3 "$REPO/scripts/vsock-connect.py" "$VSOCK" "${1:-22}"
}

do_status() {
  if is_running; then
    local p; p=$(vm_pid)
    local since; since=$(ps -o lstart= -p "$p" 2>/dev/null | sed 's/^ *//')
    echo "vm: running (pid $p, since ${since:-?})"
    echo "agent: vmcav agent           # attach to the claude session"
    echo "shell: vmcav shell           # a plain root shell in the guest"
    echo "console: $CONSOLE"
  else
    echo "vm: stopped"
  fi
}

# ssh into the guest as root over the forwarded port. Host-key checks are off
# and known_hosts is /dev/null: it's a localhost port-forward to our own VM,
# and the guest host key changes whenever the disk is recreated, so
# verification is just friction.
guest_ssh() {
  is_running || { log "vm is not running (vmcav start)"; exit 1; }
  command -v ssh >/dev/null 2>&1 || { log "ssh not found; enter the dev shell (use flake / nix develop)"; exit 1; }
  # No NIC, so ssh rides vsock via the ProxyCommand above. The hostname is a
  # placeholder the ProxyCommand ignores.
  exec ssh -t -i "$SSHKEY" \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
    -o "ProxyCommand=$SELF vsock-connect 22" \
    root@cave-guest "$@"
}

# Drive the agent: attach to its claude session (the tmux session the
# vm-root-agent unit runs). This is the primary command, so `vmcav` with no
# args does it. If the session is gone (agent crashed or was killed), start a
# fresh one; IS_SANDBOX=1 is set only here, so claude accepts
# --dangerously-skip-permissions as root, while a plain `vmcav shell` stays a
# normal unprivileged-of-that-guard shell.
do_agent() {
  guest_ssh 'tmux attach -t agent 2>/dev/null || \
    IS_SANDBOX=1 tmux new-session -s agent \
      "cd /root/coding-cave && exec claude --dangerously-skip-permissions"'
}

# A plain root shell in the guest. No args -> interactive shell; extra args run
# as a command (e.g. `vmcav shell journalctl -u vm-root-agent`).
do_shell() { guest_ssh "$@"; }

do_start() {
  if is_running; then log "already running (pid $(vm_pid))"; do_status; return 0; fi
  mkdir -p "$STATE_DIR"
  require_tools
  stage_seed; start_git_daemon
  crinj_reachable && log "crinj reachable on :$CRINJ_PORT" \
    || log "warning: crinj not reachable on 127.0.0.1:$CRINJ_PORT (no egress/auth for the agent)"

  [ -w /dev/kvm ] || { log "/dev/kvm not available; Cloud Hypervisor is"; \
    log "  KVM-only with no software fallback. Relaunch the cave with"; \
    log "  --device /dev/kvm."; return 1; }

  local disk_mb; disk_mb=$(config_disk_mb)
  # The guest bakes crinj's CA into its system trust store at build time, so
  # the PEM must be present at eval; pass it via env (the build is --impure).
  export CODING_CAVE_CRINJ_CA; CODING_CAVE_CRINJ_CA=$(cat "$SEED/ca.pem")
  log "building guest (kernel, initrd, root disk)"
  local out kernel initrd baseimg toplevel
  out=$(nix build --impure --no-link --print-out-paths \
    --extra-experimental-features 'nix-command flakes' \
    "$GUEST_FLAKE#packages.x86_64-linux.kernel" \
    "$GUEST_FLAKE#packages.x86_64-linux.initrd" \
    "$GUEST_FLAKE#packages.x86_64-linux.disk" \
    "$GUEST_FLAKE#packages.x86_64-linux.toplevel") || return 1
  kernel=$(echo "$out" | sed -n 1p)/bzImage
  initrd=$(echo "$out" | sed -n 2p)/initrd
  baseimg=$(echo "$out" | sed -n 3p)/nixos.img
  # Direct kernel boot has no bootloader to pick the generation, so the
  # cmdline names the system's init explicitly. The path is identical inside
  # the guest because the same store lives on the root disk.
  toplevel=$(echo "$out" | sed -n 4p)
  for f in "$kernel" "$initrd" "$baseimg"; do
    [ -f "$f" ] || { log "missing build artifact: $f"; return 1; }
  done

  # First start materializes the store's read-only image into a writable disk
  # and grows it to the configured cap; after that the guest owns it and
  # nixos-rebuild mutates it in place. Delete it to start clean (cattle).
  if [ ! -f "$DISK" ]; then
    log "creating guest disk from image (cap $((disk_mb / 1024)) GB, sparse)"
    cp --sparse=always "$baseimg" "$DISK"; chmod u+w "$DISK"
    truncate -s "${disk_mb}M" "$DISK"
  fi
  build_seed_image

  rm -f "$API" "$VSOCK"
  start_bridges

  # Direct kernel boot: root is the whole of vda (no partition table), the
  # seed rides on vdb, and the boot log goes to the 8250 serial port because
  # virtio_console is a module and hvc0 would be silent through early boot.
  # Emitted as a script rather than inlined into `setsid bash -c`: the nesting
  # needed to expand host paths inside a single-quoted -c string is where
  # quoting bugs live, and having the exact invocation on disk makes a failed
  # boot reproducible by hand.
  local runscript="$STATE_DIR/run-vm.sh"
  cat > "$runscript" <<EOF
#!/usr/bin/env bash
echo \$\$ > "$PIDFILE"
exec cloud-hypervisor \\
  --kernel "$kernel" \\
  --initramfs "$initrd" \\
  --cmdline "console=ttyS0 root=/dev/vda rw init=$toplevel/init" \\
  --disk path="$DISK",image_type=raw path="$SEEDIMG",readonly=on,image_type=raw \\
  --memory size=4096M --cpus boot=4 \\
  --vsock cid=$GUEST_CID,socket="$VSOCK" \\
  --api-socket path="$API" \\
  --console off --serial file="$CONSOLE"
EOF
  chmod +x "$runscript"

  log "starting vm (cloud-hypervisor, detached)"
  setsid "$runscript" > "$STATE_DIR/chv.log" 2>&1 &
  disown 2>/dev/null || true

  # Give the child a moment to write the pidfile and for CHV to survive early.
  local i=0; while [ ! -s "$PIDFILE" ] && [ "$i" -lt 20 ]; do sleep 0.2; i=$((i+1)); done
  if is_running; then
    log "vm started (pid $(vm_pid)); watch: tail -f $CONSOLE"
    log "attach once up: vmcav shell"
  else
    log "vm failed to start; see $CONSOLE"; tail -8 "$CONSOLE" 2>/dev/null >&2; return 1
  fi
}

do_stop() {
  if ! is_running; then
    log "not running"; stop_git_daemon; stop_bridges
    rm -f "$PIDFILE" "$API" "$VSOCK"; return 0
  fi
  local p; p=$(vm_pid)
  log "stopping vm (pid $p) via ACPI power-down"
  if [ -S "$API" ] && command -v ch-remote >/dev/null 2>&1; then
    timeout 5 ch-remote --api-socket "$API" power-button >/dev/null 2>&1 || true
  fi
  # Wait for a clean shutdown, signalled by EITHER qemu exiting OR the guest
  # reaching power-off in the console. Watching the console matters under TCG:
  # the guest can finish unmounting and halt ("reboot: Power down") while the
  # emulated qemu process lingers for a while; once that marker appears the
  # disk is safely unmounted, so killing the halted qemu is safe. On KVM qemu
  # just exits in seconds and the PID check returns first.
  local i=0 clean=0
  while [ "$i" -lt 240 ]; do
    kill -0 "$p" 2>/dev/null || { clean=1; break; }
    if sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g' "$CONSOLE" 2>/dev/null \
         | grep -qE "reboot: Power down|Reached target System Power Off"; then clean=1; break; fi
    sleep 1; i=$((i + 1))
  done
  if [ "$clean" = 1 ]; then
    log "guest powered down cleanly in ${i}s"
    kill -0 "$p" 2>/dev/null && { kill "$p" 2>/dev/null || true; sleep 2; kill -9 "$p" 2>/dev/null || true; }
  else
    log "power-down did not complete in ${i}s; forcing SIGTERM/SIGKILL"
    kill "$p" 2>/dev/null || true; sleep 3; kill -9 "$p" 2>/dev/null || true
  fi
  rm -f "$PIDFILE" "$API" "$VSOCK"
  stop_git_daemon; stop_bridges
  log "vm stopped"
}

case "${1:-agent}" in
  start) shift; do_start "$@" ;;
  stop) do_stop ;;
  status) do_status ;;
  agent) do_agent ;;
  shell) shift; do_shell "$@" ;;
  vsock-connect) shift; do_vsock_connect "$@" ;;
  -h|--help|help) echo "usage: vmcav {agent|start|stop|status|shell [cmd...]}" >&2 ;;
  *) echo "usage: vmcav {agent|start|stop|status|shell [cmd...]}" >&2; exit 2 ;;
esac

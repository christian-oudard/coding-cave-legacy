#!/usr/bin/env bash
# vmcav: manual lifecycle for the cave-guest VM. See `vmcav` with no args for
# the command list.
#
# The VM is long-running: `start` detaches it (new session) so it survives the
# shell, and returns. Shutdown is manual via `stop`. Bootstrap-era shell;
# migrates into the Go cave-vm binary later (see ../docs/vm-cave-design.md).
set -euo pipefail

# SELF is only for re-invoking ourselves (ssh's ProxyCommand); it must survive
# symlinks and the nix wrapper. The repo is found the way cav finds a project
# -- the cwd's git toplevel -- rather than relative to the script, so an
# installed vmcav in /nix/store still operates on your checkout. Override with
# REPO= to run from outside one.
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
# `|| true` so the hint below is what you see outside a checkout; without it
# set -e kills the script on git's exit 128 before it can print anything.
REPO="${REPO:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
[ -n "$REPO" ] || { echo "vmcav: not in a git repository (set REPO=)" >&2; exit 1; }
# Where the guest config comes from. The working tree, so what you edit is
# what `image create` builds -- no ref to move, no commit required. This
# becomes the store path the package ships (docs/vm-cave-todo.md); the
# override is already the shape that will take.
GUEST_FLAKE="${CAVE_GUEST_SRC:-$REPO/guest}"
# The guest builds cave-guestd from this Go module. It sits outside the guest
# flake's directory, so the path is passed into the (already impure) eval
# rather than being a flake input.
CAVE_VM_SRC="${CAVE_VM_SRC:-$REPO/cave-vm}"
# Where agent work lands: the project's shared bare repo, the same one the
# container caves push to. Not the working checkout -- an agent must not be
# able to write a branch into the tree someone is standing in.
SHARED="$REPO/.coding-cave/cave-shared.git"
# The project's slug, derived from the checkout the way `cav` derives one. The
# guest clones git://127.0.0.1/<slug>.git, so the daemon serves the shared repo
# under that name too: a project is a name an agent is given, not a constant.
SLUG="$(basename "$REPO")"

# Where each project's shared repo is, given its checkout, and what it is
# called. Two rules that were spelled out inline in half a dozen places and
# are now said once, because a second project makes them functions of a path
# rather than facts about the one repo vmcav was run from.
shared_repo_of() { printf '%s/.coding-cave/cave-shared.git' "$1"; }
slug_of() { basename "$1"; }
# The agent that is root in the guest holds a reserved id rather than a low
# one. It is not one of the agents a human created: it exists before any
# project is assigned, it redeploys the system the others run in, and being
# root is the point of it rather than a hazard. 0 says all of that in the
# branch namespace, where agent-0/<base> is visibly not part of the sequence,
# and leaves 1..N meaning what it means in `main`.
ROOT_AGENT_ID=0
# How many ordinary agents the guest can hold at once, which is the size of
# the agent<n> user pool declared in guest/configuration.nix. Stated in both
# places because they are two programs; if you raise one, raise the other.
MAX_AGENTS="${MAX_AGENTS:-8}"
CONFIG="${CODING_CAVE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/coding-cave/config.toml}"
STATE_DIR="${STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/coding-cave/vm}"
CRINJ_PORT="${CRINJ_PORT:-10255}"
GIT_PORT="${GIT_PORT:-9418}"
# Where the guest reaches the host's nix store. Same number on both sides: the
# guest's socat bridge listens on this port and dials vsock 7100.
NIX_CACHE_PORT="${NIX_CACHE_PORT:-7100}"

DISK="$STATE_DIR/cave-guest.raw"
# Out-links for the boot artifacts, which makes them gc roots: the store must
# not collect the kernel, initrd or system the disk is running.
BOOT="$STATE_DIR/boot"
# Where a kernel or initrd extracted back out of the guest disk lands, for the
# case where the host store no longer has the one the guest is running.
BOOTCACHE="$STATE_DIR/boot-disk"
SEEDIMG="$STATE_DIR/cave-seed.raw"
CONSOLE="$STATE_DIR/console.log"
SEED="$STATE_DIR/cave-host"
SSHKEY="$STATE_DIR/agent_ssh_key"
# The VM's own claude login, kept outside the disk so it outlives a reformat.
# This is the placeholder crinj minted for the guest when the guest logged
# in, not anything of the host's: worthless off this crinj, and the only
# thing standing between you and a /login after every reformat.
GUESTCRED="$STATE_DIR/guest-credentials.json"
# The VM's claude state: which account, what it has been told once already
# (trust, onboarding, dialogs it has accepted). Captured from the guest for
# the same reason as the credential, and deliberately not taken from the
# host's ~/.claude.json, whose flags are keyed to the host's own project
# paths and never applied to /root/coding-cave anyway.
GUESTCFG="$STATE_DIR/guest-claude.json"
GITPID="$STATE_DIR/git-daemon.pid"
GPGPID="$STATE_DIR/gpg-broker.pid"
# The projects the guest can reach, as a directory of <slug>.git symlinks into
# each project's own shared repo. This is the git daemon's base-path, and it
# is also the registry: a project is registered exactly when a link to it is
# here, so there is no list to keep in step with the filesystem and no way for
# the two to disagree. It cannot live inside a project, which is where the
# shared repo sits, because a directory inside one project cannot serve
# another.
REPOS="$STATE_DIR/repos"
# The VMM and the whole vsock service plane belong to `cave-vm`, which is where
# the difference between a Linux host (Cloud Hypervisor) and an Apple silicon
# host (vfkit) lives. Socket paths are its business too, so ask rather than
# recompute them here: two derivations of the same path is one bug waiting.
GUEST_CID="${GUEST_CID:-3}"
# One definition of how to reach the guest, in a file rather than an argument
# list, because ssh is not the only thing that has to use it: `nix copy` takes
# extra ssh arguments through NIX_SSHOPTS, which it splits on whitespace, and
# the ProxyCommand has spaces in it. A config file is the only form all of
# them can share.
#
# Host-key checks are off and known_hosts is /dev/null: this is our own VM
# over a socket only we can open, and the guest's key changes every time the
# disk is recreated, so verification is friction with nothing behind it.
SSHCONF="$STATE_DIR/ssh_config"
write_ssh_config() {
  mkdir -p "$STATE_DIR"
  cat > "$SSHCONF" <<EOF
Host cave-guest
  User root
  IdentityFile $SSHKEY
  IdentitiesOnly yes
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
  ProxyCommand $SELF vsock-connect 22
EOF
}
write_ssh_config
GUEST_SSH_OPTS=(-F "$SSHCONF")

log() { printf '[vmcav] %s\n' "$*" >&2; }

# Max disk size in MiB, from config.toml (default 100 GB). Sparse, so the cap
# is elastic; it consumes only what the guest writes.
config_disk_mb() {
  python3 - "$CONFIG" <<'PY'
import sys, os, tomllib
p = sys.argv[1]; cfg = {}
if os.path.exists(p):
    with open(p, "rb") as f: cfg = tomllib.load(f)
print(int(cfg.get("vm", {}).get("disk_size_gb", 100)) * 1024)
PY
}

# Guest RAM in MiB: `[vm] memory_mb` from config.toml, or half the host's.
#
# Half, rather than a constant, because the constant was the bug. 4096 was
# enough for one agent and not much else -- a single claude session has been
# measured peaking at 3.3G -- and the guest has no swap, so overshooting that
# ceiling is a wall and not a slope: it evicts page cache and reads it straight
# back, hundreds of gigabytes off the disk, an agent that looks hung rather
# than one that looks slow. A fraction tracks the host it is actually on
# instead of being wrong on both a laptop and a workstation.
#
# Half specifically because this memory is not elastic the way the disk is: it
# is taken from the host for as long as the VM runs, and the host is still
# running the editor, the browser and the nix builds that the guest substitutes
# from. Leaving the other half is what keeps raising this from turning a stalled
# guest into a stalled host.
#
# sysconf rather than /proc/meminfo: this runs on the Apple silicon host too,
# where there is no procfs (docs/vm-cave-cross-platform.md).
config_memory_mb() {
  python3 - "$CONFIG" <<'PY'
import sys, os, tomllib
p = sys.argv[1]; cfg = {}
if os.path.exists(p):
    with open(p, "rb") as f: cfg = tomllib.load(f)
mb = cfg.get("vm", {}).get("memory_mb")
if mb is None:
    host_mb = os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE") // (1024 * 1024)
    # The floor is not a preference, it is the smallest guest that has been
    # seen to run an agent without thrashing. A host too small to give that up
    # is better off being told the number is too big for it than being handed
    # a guest that stalls.
    mb = max(host_mb // 2, 4096)
print(int(mb))
PY
}

vm_pid() { cave-vm running --state "$STATE_DIR" --disk "$DISK" 2>/dev/null || true; }
is_running() { cave-vm running --state "$STATE_DIR" --disk "$DISK" >/dev/null 2>&1; }

# vmcav's tools come from the dev shell (flake.nix devShell). Fail early with
# guidance rather than silently running degraded. The VMM itself is not in this
# list: which one is needed depends on the host platform, and `cave-vm start`
# checks for it (and for /dev/kvm, which Cloud Hypervisor cannot do without).
require_tools() {
  local missing="" t
  for t in ssh-keygen git python3 cave-vm mke2fs debugfs gpg; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  done
  [ -z "$missing" ] && return
  log "missing tools:$missing"
  log "enter the dev shell first:  nix develop $REPO   (or 'use flake' in .envrc)"
  exit 1
}

# The seed reaches the guest as a small read-only ext4 disk on /dev/vdb. CHV
# has no 9p and its virtio-fs needs a virtiofsd the launcher would have to
# supervise, which is far more machinery than a few static files deserve.
# `mke2fs -d` populates a filesystem from a directory with no mount and no
# root, so this stays inside the rootless footprint.
build_seed_image() {
  rm -f "$SEEDIMG"
  mke2fs -q -t ext4 -d "$SEED" -b 1024 "$SEEDIMG" 65536
}

# Stage host-specific runtime files into the seed dir, which build_seed_image
# turns into the read-only /dev/vdb disk. The crinj CA is
# mandatory: it is baked into the guest's system trust store at build time
# (security.pki), so a missing CA is a hard error, not a warning, else the
# build throws with a less obvious message.
stage_seed() {
  mkdir -p "$SEED"
  local ca=""
  # /etc/crinj-ca.pem is where a container cave mounts its own CA, so this
  # also works when vmcav runs nested inside one.
  for c in "$HOME/.crinj/gateway/ca.pem" \
           "${XDG_DATA_HOME:-$HOME/.local/share}/crinj/gateway/ca.pem" \
           "/etc/crinj-ca.pem"; do
    [ -f "$c" ] && { ca="$c"; break; }
  done
  [ -n "$ca" ] || { log "crinj CA not found (looked in ~/.crinj/gateway/ and"; \
    log "  \$XDG_DATA_HOME/crinj/gateway/); start crinj first"; exit 1; }
  cp -f "$ca" "$SEED/ca.pem"
  [ -f "$GUESTCFG" ] && install -m600 "$GUESTCFG" "$SEED/claude.json" || true
  [ -f "$GUESTCRED" ] && install -m600 "$GUESTCRED" "$SEED/credentials.json" || true
  [ -f "$SSHKEY" ] || ssh-keygen -t ed25519 -N '' -f "$SSHKEY" -C vmcav >/dev/null
  cp -f "$SSHKEY.pub" "$SEED/authorized_keys"
  # The control plane's shared secret, minted on first use like the cache key.
  # It is a bearer token even though the vsock socket is already owner-only,
  # because the same protocol has to work for a cave that is not on this
  # machine, and a local-only exemption is a capability that exists on one
  # transport and not the other.
  install -m600 /dev/null "$SEED/control-token"
  guest_rpc token > "$SEED/control-token"
  stage_pubring
  stage_gitconfig
  stage_nix_conf
}

# The guest substitutes from the host's store over vsock 7100, which needs two
# things it cannot know at build time: that the substituter exists, and which
# key signs it. Both go in a nix.conf fragment the guest !includes from the
# seed, so the key is generated on this machine and never committed.
#
# extra- forms, not the plain ones: the plain settings would replace what the
# guest's own configuration set, and the point is to add a substituter ahead of
# cache.nixos.org, not to take it away. Ahead of it by priority, which the
# cache serves as 10 against cache.nixos.org's 40, rather than by list order.
stage_nix_conf() {
  cat > "$SEED/nix.conf" <<EOF
extra-substituters = http://127.0.0.1:$NIX_CACHE_PORT
extra-trusted-public-keys = $(cave-vm cache-key --state "$STATE_DIR")
EOF
}

# The agent has to commit before it can push, and git refuses to commit
# without an identity. Carry the host's, the same way the Rust implementation
# gives container caves the host's identity, rather than inventing one. Only
# user.name/user.email are copied, not the whole host gitconfig, which
# routinely carries signing keys, credential helpers, and includes that name
# host paths meaningless inside the guest. Absent identity is not fatal here:
# the guest unit falls back so a boot still yields a usable agent.
stage_gitconfig() {
  local name email
  name=$(git config --global user.name 2>/dev/null || true)
  email=$(git config --global user.email 2>/dev/null || true)
  SIGNING_KEY=$(git config --global user.signingkey 2>/dev/null || true)
  local sign; sign=$(git config --global commit.gpgsign 2>/dev/null || true)
  if [ -z "$name" ] && [ -z "$email" ]; then
    rm -f "$SEED/gitconfig"
    log "warning: no global git user.name/user.email; guest will use a fallback identity"
    return
  fi
  { echo "[user]"
    [ -n "$name" ]  && printf '\tname = %s\n' "$name"
    [ -n "$email" ] && printf '\temail = %s\n' "$email"
    # Signing is safe to carry across because the guest's gpg.program is the
    # shim, so this only decides *whether* to sign; the key itself never
    # leaves the host. Carrying it matters: unsigned agent commits were a
    # known disaster for container caves.
    [ -n "$SIGNING_KEY" ] && printf '\tsigningkey = %s\n' "$SIGNING_KEY"
    [ "$sign" = "true" ] && printf '[commit]\n\tgpgsign = true\n'
  } > "$SEED/gitconfig"
}

# One silent probe, for polling: guest_ssh explains its failures, which is
# exactly wrong once a second while a guest boots.
guest_ready() {
  ssh -T -o ConnectTimeout=5 -o BatchMode=yes "${GUEST_SSH_OPTS[@]}" \
    root@cave-guest true >/dev/null 2>&1
}

# Why the guest cannot be reached, when the answer is not "it is still booting".
#
# Every route to a running guest goes through one unix socket, and if that
# file is not there nothing works and everything says the same thing: the
# guest is not answering ssh. That sentence sends you to the console log, and
# the console log shows a guest that is perfectly well.
#
# The case that produced it: the socket moved. It used to be a flat name in
# /tmp and is now a file inside a per-uid directory, so a VM started before
# that change keeps its socket at the old path while the upgraded tool looks
# at the new one. The VM is running, the guest is fine, and they cannot find
# each other. Worth naming, because the fix is two symlinks or a restart and
# neither is guessable from "not answering ssh".
explain_unreachable_guest() {
  local sock; sock=$(cave-vm socket --state "$STATE_DIR" 2>/dev/null || true)
  [ -n "$sock" ] || return 0
  [ -S "$sock" ] && return 0
  log "  the socket every route to the guest uses is not there:"
  log "    $sock"
  local old="/tmp/vmcav-$(id -u)-$(basename "$sock")"
  if [ -S "$old" ] || [ -S "$old.vsock" ]; then
    log "  but a socket from before it moved is:"
    log "    $old"
    log "  this VM was started by a vmcav that kept sockets directly in /tmp."
    log "  Either link them across:"
    log "    mkdir -p -m 700 $(dirname "$sock") && ln -s $old $sock"
    log "  or stop the VM and start it again, which loses running agents but"
    log "  keeps everything on the guest's disk."
  else
    log "  so the VM is running with nothing listening for us. Stopping and"
    log "  starting it again is the way back."
  fi
  return 0
}

# The agent is up when the daemon answers and reports a running session.
# Checking the socket file alone would pass on a leftover from a crash.
agent_ready() {
  ssh -T -o ConnectTimeout=5 -o BatchMode=yes "${GUEST_SSH_OPTS[@]}" \
    root@cave-guest "cave-guestd list | grep -q ' running '" \
    >/dev/null 2>&1
}

# `start` returns when the guest can be used, not when the VMM has been
# spawned: the gap between those is a minute of boot, and every command in
# it fails in a way that reads like a bug.
wait_for_guest() {
  local i=0 max="${CAVE_BOOT_TIMEOUT:-180}"
  log "waiting for the guest to finish booting"
  while [ "$i" -lt "$max" ]; do
    if ! is_running; then
      log "the vm exited while booting; last of $CONSOLE:"
      tail -5 "$CONSOLE" >&2 2>/dev/null || true
      return 1
    fi
    # sshd answering is the whole of "booted" now. This used to wait for an
    # agent session as well, which was right while one started at boot and is
    # wrong now that a project is something an agent is given: there is
    # nothing to wait for until you run `vmcav agent`.
    #
    # No duration: it would time this loop and not the start you waited
    # through, and a number that disagrees with the clock is worse than none.
    guest_ready && { log "guest ready"; return 0; }
    sleep 1; i=$((i + 1))
  done
  log "the guest did not answer ssh in ${max}s; it is still running."
  log "  see $CONSOLE, or raise CAVE_BOOT_TIMEOUT"
  return 1
}

# Copy the guest's login out to the host, so the next disk starts logged in.
# Taken during a reformat and nowhere else: that is the only sequence about to
# destroy the disk it lives on, and it is the last moment a running guest can
# still be read. Nothing else has business reaching into the guest for it.
#
# The file is copied as it stands. It carries no secret -- the tokens in it are
# crinj placeholders, and crinj holds the real ones in its vault keyed by them,
# rotating them under the same placeholders on refresh, which is what makes
# them worth carrying at all. The placeholder check is not about the guest's
# honesty but about not persisting a real token host-side by accident: if the
# guest somehow holds one, leave it on the disk.
#
# Silent throughout, including when it declines. Every path here is either
# routine (no login yet, an unchanged file, a token refresh) or a decision
# not to copy something, and none of it is a thing the user acts on.
capture_guest_credentials() {
  is_running || return 0
  local cred
  cred=$( (GUEST_SSH_TTY=-T guest_ssh cat /root/.claude/.credentials.json) 2>/dev/null || true)
  # No file at all is the normal state of a guest that has not logged in yet,
  # so it is not worth a word.
  [ -n "${cred//[$'\r\n\t ']/}" ] || return 0
  # Field by field, not a substring match on the file: a real access token
  # next to a placeholder refresh token would pass the latter. Every token
  # must be crinj's, and an unrecognized shape (missing fields, a format we
  # do not know) fails closed and stays in the guest.
  local ok; ok=$(printf '%s' "$cred" | jq -r '
    [.claudeAiOauth.accessToken, .claudeAiOauth.refreshToken] as $t
    | if any($t[]; type != "string") then "no"
      elif all($t[]; test("crinj-placeholder")) then "yes"
      else "no" end' 2>/dev/null || echo no)
  [ "$ok" = yes ] || return 0
  [ "$cred" = "$(cat "$GUESTCRED" 2>/dev/null || true)" ] && return 0
  (umask 077; printf '%s' "$cred" > "$GUESTCRED")
  return 0
}

# The other half of the VM's claude state: the account it is logged into and
# every "do not ask me again" it has earned. Taken at the same moment as the
# credential, so a reformat costs neither a login nor a round of dialogs.
# Only well-formed JSON is kept, so a half-written file cannot poison the
# next disk.
capture_guest_config() {
  is_running || return 0
  local cfg
  cfg=$( (GUEST_SSH_TTY=-T guest_ssh cat /root/.claude.json) 2>/dev/null || true)
  printf '%s' "$cfg" | jq -e . >/dev/null 2>&1 || return 0
  [ "$cfg" = "$(cat "$GUESTCFG" 2>/dev/null || true)" ] && return 0
  (umask 077; printf '%s' "$cfg" > "$GUESTCFG")
  return 0
}

# Public keyring only, for in-guest verification. Secret key material stays
# here; the guest reaches it solely through the broker, one operation at a
# time, and never as a key.
stage_pubring() {
  local hd; hd=$(gpgconf --list-dirs homedir 2>/dev/null || echo "$HOME/.gnupg")
  [ -f "$hd/pubring.kbx" ] && cp -f "$hd/pubring.kbx" "$SEED/pubring.kbx" || true
}

# The agent's remote is the project's shared bare repo, never the human's
# working checkout. Serving the checkout is what let a guest push a branch
# straight into the tree someone is standing in, and it meant `--export-all`
# over the directory the project happens to sit next to. The shared repo is
# the same one the container caves use, so one project has one place agent
# work lands and one set of branches to review.
ensure_shared_repo() {
  local repo="${1:-$REPO}" shared
  shared=$(shared_repo_of "$repo")
  if [ ! -d "$shared" ]; then
    log "creating the shared repo at $shared"
    mkdir -p "$(dirname "$shared")"
    git clone --bare --quiet "$repo" "$shared"
    # Bare clones inherit origin; the shared repo is nobody's client.
    git -C "$shared" remote remove origin 2>/dev/null || true
  fi
  # The other direction: review and approve read the agent's branches through
  # this checkout's remote-tracking refs, so the repo that has them needs a
  # name here.
  ensure_cave_remote "$repo"
}

# Hooks are shims that exec a helper by name from PATH, so nothing here bakes
# a store path that a gc or an upgrade can invalidate, and vmcav carries its
# own hooks instead of reading them out of whichever checkout you happen to be
# standing in.
#
# Only when the repo has none: on a machine that also runs the container
# caves, their hooks already guard this repo and are the ones exercised by
# every push it takes. Replacing them with ours would swap a live guard for an
# equivalent-by-design one that has never seen those push paths.
install_shared_hooks() {
  local shared h
  shared=$(shared_repo_of "${1:-$REPO}")
  h="$shared/hooks"
  mkdir -p "$h"
  # Always ours, and keep whatever was there before.
  #
  # Two failures produced this, in order. First it returned the moment a
  # pre-receive existed, so the guard was written once and never again and
  # every later fix reached new projects only. Then it refused to touch a hook
  # it had not written, on the reasoning that this shared repo is the one the
  # container caves on `main` use and their guard is not ours to replace --
  # which is true, and which left the only repo in use running `cav`'s hook
  # and rejecting every agent but one, for four rounds of "fixed" that never
  # reached it.
  #
  # So: this owns the hook. Two tools cannot both own one, and the one that
  # runs the VM is the one whose rules have to apply -- `cav`'s guard does not
  # know that a whole guest shares an injected id, which is the thing that
  # broke. The old hook is kept beside it rather than deleted, so the change
  # is visible and reversible, and it is said out loud rather than done
  # quietly: if you run both tools against this repo, this is the moment the
  # rules changed.
  if [ -e "$h/pre-receive" ] && ! grep -q cave-vm-git-pre-receive "$h/pre-receive"; then
    mv "$h/pre-receive" "$h/pre-receive.replaced-by-vmcav"
    log "replaced a pre-receive hook this did not install, in $shared"
    log "  the old one is beside it as pre-receive.replaced-by-vmcav"
  fi
  # Written every time rather than only when absent, so a fix to the guard
  # reaches a repo that already has one. Said out loud only when the bytes
  # change: `vmcav init` registers the project and then starts the daemon,
  # which registers it again, so this ran twice per invocation and announced
  # an installation twice -- which reads like something going wrong, or like
  # the command not being safe to repeat. It is safe to repeat; it was only
  # noisy about it.
  local pre post changed=""
  pre='#!/bin/sh
exec cave-vm-git-pre-receive "$@"'
  post='#!/bin/sh
exec cave-vm-git-post-receive "$@"'
  [ "$(cat "$h/pre-receive" 2>/dev/null)" = "$pre" ] || changed=1
  [ "$(cat "$h/post-receive" 2>/dev/null)" = "$post" ] || changed=1
  [ -n "$changed" ] && log "installing receive hooks in $shared"
  printf '%s\n' "$pre" > "$h/pre-receive"
  printf '%s\n' "$post" > "$h/post-receive"
  chmod 755 "$h/pre-receive" "$h/post-receive"
  return 0
}

# Carry the human's commits into the shared repo, the agent's host-cave.
# Without this the shared repo is a snapshot taken when the VM was created:
# the agent clones a base that is however many commits stale, rebases onto it,
# and conflicts with work it cannot see. Observed, not theoretical.
#
# A fetch into the bare repo rather than a push out of the checkout. Fetch
# does not run pre-receive at all, and it refuses a non-fast-forward without
# a leading +, so the safe case needs no flag and the unsafe one cannot happen
# by accident.
#
# Base branches only: an agent branch belongs to the agent, and the shared
# repo's copy is the one it pushed.
refresh_shared_base() {
  local branch
  branch=$(git -C "$REPO" symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0
  case "$branch" in agent-*/*) return 0 ;; esac
  git -C "$REPO" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null || return 0
  if git -C "$SHARED" fetch --quiet "$REPO" \
       "refs/heads/$branch:refs/heads/$branch" 2>/dev/null; then
    return 0
  fi
  log "warning: the shared repo could not fast-forward '$branch' from your checkout"
  log "  the agent will start from the base it already has (vmcav push --force to move it)"
  return 0
}

# The human's half of the git flow: send this checkout's branch to the shared
# remote the agent knows as host-cave. `main` spells this `cav push`, and
# it is what keeps an agent working against current code rather than against
# whatever was there when its VM was made.
do_push() {
  local force="" branch
  [ "${1:-}" = "--force" ] && { force="+"; shift; }
  branch="${1:-$(git -C "$REPO" symbolic-ref --quiet --short HEAD)}"
  [ -n "$branch" ] || { log "no branch to push (detached HEAD; name one)"; return 1; }
  ensure_shared_repo
  git -C "$REPO" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null \
    || { log "no such branch in this checkout: $branch"; return 1; }
  if ! git -C "$SHARED" fetch --quiet "$REPO" \
        "${force}refs/heads/$branch:refs/heads/$branch"; then
    log "'$branch' is not a fast-forward of the shared repo's copy"
    log "  someone else moved it; rebase, or vmcav push --force to overwrite"
    return 1
  fi
  log "$branch -> shared repo ($(git -C "$SHARED" rev-parse --short "$branch"))"
}

# Make a project reachable from the guest, and say so by linking it into the
# served directory. Idempotent: run it on a project already registered and it
# refreshes the link and returns.
#
# <slug>.git rather than the shared repo's own name, because the guest asks
# for a project by name -- git://127.0.0.1/<slug>.git -- and a project is a
# name an agent is given rather than a path it has to know. A symlink rather
# than a move: the shared repo is the same one the container caves use, and
# they know it by its own path inside the project.
register_project() {
  local repo="${1:-$REPO}" want="${2:-}" slug target held
  git -C "$repo" rev-parse --show-toplevel >/dev/null 2>&1 || {
    log "$repo is not a git checkout"; return 1; }
  repo=$(git -C "$repo" rev-parse --show-toplevel)
  slug="${want:-$(slug_of "$repo")}"
  target=$(shared_repo_of "$repo")

  # A slug is a directory's basename, and two checkouts can have the same one:
  # ~/work/docs and ~/other/docs are both `docs`. The link was written with
  # `ln -sfn`, so the second registration took the name from the first without
  # a word -- and what it took is what the guest resolves `git://127.0.0.1/
  # docs.git` to, so an agent given "docs" would go on working against a
  # repository nobody had told it about. `vmcav projects` showed one entry
  # either way.
  #
  # Checked before anything is created, so a refused registration leaves no
  # shared repo and no hooks behind in a project that is not registered.
  #
  # A dangling link is replaced rather than defended: its project has moved or
  # gone, re-registering is the documented repair, and there is nothing left
  # for the name to be taken from.
  if [ -L "$REPOS/$slug.git" ]; then
    held=$(project_target "$slug")
    if [ "$held" != "$target" ] && [ -d "$held" ]; then
      log "'$slug' is already registered, and to a different project:"
      log "  registered: $held"
      log "  asked for:  $target"
      log "the guest resolves a project by this name, so one of them has to"
      log "have another:  vmcav init $repo --as <name>"
      return 1
    fi
  fi

  ensure_shared_repo "$repo" || return 1
  install_shared_hooks "$repo" || return 1
  mkdir -p "$REPOS"
  ln -sfn "$target" "$REPOS/$slug.git"
  printf '%s' "$slug"
}

# Every project the guest can reach, by slug.
registered_projects() {
  [ -d "$REPOS" ] || return 0
  local link
  for link in "$REPOS"/*.git; do
    [ -L "$link" ] || continue
    basename "$link" .git
  done
}

# Which paths the git daemon is allowed to serve, one per line: each
# registration and what its link resolves to. Both, because git daemon
# compares the resolved path against what it was given -- list only the link
# and every request is refused, list only the target and the guest cannot ask
# for it by project name.
#
# A registration whose target has moved is left out rather than handed over
# dead, and said out loud. A dead path here answers the guest with "repository
# not found", which is indistinguishable from never having registered the
# project, and the host said nothing either way.
#
# Its own function so it can be checked without starting a daemon.
git_daemon_serve_args() {
  cave-vm projects --state "$STATE_DIR" --serve-args
}

start_git_daemon() {
  # The project vmcav was run from is registered on the way past, so the
  # common case -- one project, never having heard of `vmcav init` -- needs no
  # ceremony. Others are added by `vmcav init` and persist in the served
  # directory, so a restart keeps serving them.
  register_project "$REPO" >/dev/null || return 1
  local dir="$REPOS"
  pgrep -f "git daemon.*--base-path=$dir" >/dev/null 2>&1 && return
  # Who the daemon attributes a push to. Not the daemon's own identity: it is
  # what the daemon asserts about whoever connected, injected as env so
  # git-daemon's receive-pack children and their hooks inherit it, and the
  # hook reads an id the client never sent and so cannot forge. Every agent
  # gets a normal number (the registry issues from 1); root is a separate
  # property, not a reserved id.
  #
  # The id therefore belongs to a connection, not to a process, and this only
  # works because there is exactly one client. Every agent's connection
  # arrives on the same socket, so when there are several the host cannot tell
  # them apart in principle rather than merely in practice, and only the side
  # that opened them can. That, not the port table, is why the stamp has to
  # move into the guest (docs/vm-cave-todo.md).
  # VM-wide, and that is the flaw rather than a placeholder to fill in.
  # `start` starts the VM, which serves every agent in it, so at this point
  # nobody knows who will push. It is correct only while there is exactly one
  # agent. Note the guest defaults to 1 independently, in clone-repo, so the
  # two must agree or every push is rejected as out-of-namespace.
  #
  # Neither a daemon per agent nor an id staged into the seed fixes it: the
  # first needs a vsock port per agent and the port table is fixed in the VM's
  # launch argv, and the second bakes one agent's identity into a disk shared
  # by all of them. The id has to arrive with the connection, stamped by
  # cave-guestd on the guest side of one shared port, which needs caves to
  # exist first (docs/vm-cave-todo.md).
  #
  # One directory is whitelisted and it is the shared repo, so a request for
  # any other path on this port resolves to nothing.
  # Defaults to the root agent's id, because the root agent is the one that
  # exists before anybody creates another and the only one that has ever
  # pushed through here. That is a statement about today, not a design: the
  # moment a second agent pushes, this stamp is wrong for one of them.
  # The whitelist, one entry per registered project and one for what its link
  # resolves to. Both, because git daemon compares the resolved path against
  # what it was given: list only the link and every request is refused, list
  # only the target and the guest cannot ask for it by project name.
  local -a serve=()
  local path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    serve+=("$path")
  done < <(git_daemon_serve_args)

  # Loopback only. Without --listen, git daemon binds every address the host
  # has, and this daemon has receive-pack enabled.
  #
  # What that opened, demonstrated rather than reasoned (docs/vm-cave-red-team.md
  # finding 7): every container on the host's bridge and every host on its LANs
  # could read the project and push into the shared bare repo. Such a client
  # inherits CODING_CAVE_AGENT_ID from this environment exactly as the guest
  # does, so its pushes are stamped as the root agent and land in agent-0/* --
  # the precise namespace a human reads with `vmcav review` and lands with
  # `vmcav approve`. pre-receive still refuses base branches, so it could not
  # move one directly; it could put commits where somebody was about to.
  #
  # It also gave the guest a second way in. crinj refuses CONNECT to loopback,
  # which is the guard against the guest reaching back into the host, but the
  # host owns non-loopback addresses too: CONNECT to the docker bridge address
  # on this port returned this daemon's real ref advertisement, through the one
  # channel whose job is to prevent that.
  #
  # The sanctioned route is unaffected: `cave-vm start --git 127.0.0.1:$GIT_PORT`
  # is the relay behind vsock 7300, and it dials loopback.
  #
  # This closes the LAN half completely. The other half -- a guest reaching it
  # by address at all -- wants the daemon off TCP entirely, behind a unix
  # socket, so that it is unreachable by any address rather than by the ones
  # crinj happens to deny.
  # And a marker that this push came through the daemon at all, so the hook
  # can tell a guest push whose id went missing from the human's own, which
  # arrives with no id and is exempt. Those are the same empty string
  # otherwise, and the exemption is the whole approval gate.
  CODING_CAVE_AGENT_ID="${AGENT_ID:-$ROOT_AGENT_ID}" \
  CODING_CAVE_FROM_GUEST=1 \
  git daemon --reuseaddr --listen=127.0.0.1 \
    --export-all --enable=upload-pack --enable=receive-pack \
    --base-path="$dir" --port="$GIT_PORT" --detach --pid-file="$GITPID" \
    "${serve[@]}"
  # Deliberately silent about the agent id. At start there is no agent, so
  # announcing who pushes get attributed to describes nobody; it is said when
  # an agent is created, which is when it becomes true.
  log "git daemon serving $(registered_projects | tr '\n' ' ')on :$GIT_PORT"
}
stop_git_daemon() { [ -f "$GITPID" ] && { kill "$(cat "$GITPID")" 2>/dev/null || true; rm -f "$GITPID"; }; }

# Serve a project registered since the daemon started.
#
# The whitelist is an argument list, fixed when the process began, so a new
# registration is invisible to a running daemon. The advice used to be `vmcav
# stop && vmcav start`, which reaches the daemon by taking down the VM and
# every agent session in it -- an enormous instrument for a process that
# restarts in milliseconds.
#
# What it costs is a push crossing at that moment, which fails and is retried
# by the agent that made it: cave-git warns on a push it could not land, and
# the commit is still in the guest. That is a smaller thing to lose than every
# agent's terminal, and it is the same risk `stop` takes anyway.
restart_git_daemon() {
  stop_git_daemon
  # Wait for it to go rather than assume: start_git_daemon returns early when
  # it still sees one running, which would leave the old whitelist serving and
  # the new project just as invisible, with nothing saying so.
  # Polled rather than slept through: it is gone in milliseconds and the cap
  # is only there so a daemon that will not die reports it instead of hanging.
  local waited=0
  while pgrep -f "git daemon.*--base-path=$REPOS" >/dev/null 2>&1; do
    [ "$waited" -ge "${GIT_DAEMON_STOP_TRIES:-50}" ] && {
      log "the old git daemon did not stop"; return 1; }
    waited=$((waited + 1))
    sleep 0.1
  done
  start_git_daemon
}

# crinj is not always on loopback: inside a cave it lives at the gateway
# address. `cave-vm start` relays vsock 7200 here.
CRINJ_ADDR="${CRINJ_ADDR:-127.0.0.1:$CRINJ_PORT}"

# The signing broker is its own unix-socket server, so it binds the vsock path
# directly rather than being a relay target like crinj and git. It is the only
# channel by which the guest can reach the host's key, and it exposes one
# operation rather than the whole gpg-agent protocol.
#
# Started before the VM, not after: the socket has to be there when the guest
# first looks. `cave-vm start` leaves sockets it does not own alone, so the
# order is safe.
start_gpg_broker() {
  stop_gpg_broker
  local sock; sock=$(cave-vm socket --state "$STATE_DIR" 7400)
  rm -f "$sock"
  CAVE_SIGNING_KEY="${SIGNING_KEY:-}" \
    python3 "$REPO/scripts/gpg-broker.py" "$sock" \
    >> "$STATE_DIR/gpg-broker.log" 2>&1 &
  echo $! > "$GPGPID"
}

stop_gpg_broker() {
  [ -f "$GPGPID" ] || return 0
  kill "$(cat "$GPGPID")" 2>/dev/null || true
  rm -f "$GPGPID"
}

crinj_reachable() { (exec 3<>"/dev/tcp/${CRINJ_ADDR%:*}/${CRINJ_ADDR##*:}") 2>/dev/null; }

# ssh ProxyCommand. How a host-initiated connection reaches the guest differs
# per VMM, which is exactly why it is not written out here any more.
do_vsock_connect() {
  exec cave-vm vsock-connect --state "$STATE_DIR" "${1:-22}"
}

# Status is the command you run when something is wrong, so it is the one
# command that must not fail the way the others may.
#
# It did. This script runs under `set -e`, and every question status asks
# touches something that can be missing -- a socket, a pidfile, a repo, a
# guest that has stopped answering. One unguarded non-zero anywhere in there
# ended the whole script before the first line was printed, so the report on
# a broken cave was an empty screen and an exit code. Reported from a real
# host, where it was reproducible and silent.
#
# The body runs on the left of `||`, which is where errexit does not apply, so
# a failure part way through leaves whatever was already printed and adds a
# line saying it stopped early. A partial answer beats none; an empty screen
# is the one thing that cannot be acted on.
do_status() {
  status_report || {
    local rc=$?
    log "status stopped early (exit $rc); what is above is what it got to"
    log "  to see where:  bash -x \$(command -v vmcav) status"
    return "$rc"
  }
}

status_report() {
  # First, and whether or not the VM is up: a broken guard is a host-side fact
  # and the thing most likely to be silently wrong, since it fails by refusing
  # pushes in a way that reads like the guard working.
  warn_if_hooks_are_foreign
  # Nothing announces a push: the agent commits, the daemon accepts it, and
  # the ref moves in silence. Status is where you find out one arrived, and it
  # says so with the VM stopped too, because the work arrived either way.
  if ! is_running; then
    # Whether there is an image at all, because "stopped" answered two
    # different questions with one word: a VM you can start, and a VM that was
    # never created. Only `start` knew the difference, and only by refusing.
    if [ -f "$DISK" ]; then
      echo "vm: stopped"
      # Staleness is most worth saying here, not less: `start` boots what the
      # disk says, so a stopped guest is exactly the one about to run old code.
      # It used to be reported only in the running branch below, which is after
      # the moment you could have acted on it.
      warn_if_guest_is_behind
    else
      echo "vm: no image yet (vmcav image create)"
    fi
    cave_vm pending || true
    return 0
  fi
  # An empty pid means the VM is running under a supervisor this side cannot
  # see: another cave, or the host. Say so rather than printing a pid nobody
  # can use, and do not go on to ask the guest questions -- the ssh path here
  # belongs to whoever started it.
  local p; p=$(vm_pid)
  if [ -z "$p" ]; then
    echo "vm: running, started elsewhere on this machine (one cave VM per machine)"
    echo "  stop it where it was started; this side cannot reach its sockets"
    cave_vm pending || true
    return 0
  fi
  # The human's own commits, before anything asks what is pending: an agent
  # rebases onto the shared repo, and a base that has not caught up makes its
  # next rebase a conflict against work it cannot see.
  carry_base_to_shared
  # The clock, before anything reads it: every question below is about a
  # running guest, and a guest whose clock is wrong answers them all while
  # failing everything an agent tries.
  correct_guest_clock
  local since; since=$(ps -o lstart= -p "$p" 2>/dev/null | sed 's/^ *//' || true)
  echo "vm: running (pid $p, since ${since:-?})"
  # Which generation it is on is status, not version: the host boots one
  # toplevel and the agent's nixos-rebuild moves the guest off it in place.
  # Equal is the normal case and says nothing twice, so only the divergence
  # gets two lines.
  # Which generation the guest is on, rendered by cave-vm. Both halves used
  # to be sed: the booted one out of run-vm.sh, a script that program writes,
  # and the current one out of `health`, over a struct field formatted into a
  # line so it could be parsed back.
  cave-vm system --state "$STATE_DIR" || true

  # The roster, rendered by cave-vm rather than re-parsed here.
  #
  # This was thirty lines of awk over the machine-readable form cave-vm had
  # just printed, and both bugs it grew came from that round trip: ' running '
  # needs a space on each side, so an agent with no project fell out of the
  # count, and `|| true` made "the guest did not answer" and "the guest has
  # nothing" the same empty string. Neither is expressible on the other side
  # of this line, where an agent is a struct and reachability is its own
  # argument.
  #
  # Exit 3 is "could not ask", which is not a failure of the command: status
  # says so and carries on.
  cave-vm agents --state "$STATE_DIR" || [ "$?" = 3 ] || true

  echo "console: $CONSOLE"
  warn_if_guest_is_behind
  cave_vm pending || true
}

# --- Review and land what the agent pushed ---
# The agent commits in the guest and pushes over the vsock git bridge into the
# project's shared repo, where the pre-receive guard confines it to
# agent-N/<base>. That last hop, agent-N/<base> into <base>, is the one it
# deliberately cannot make itself, so it is the one command a human runs.
#
# Both verbs work in your checkout, against the `cave` remote, which is how
# `main` does it: review checks the agent's branch out so you read it with
# your own tools, and approve moves the base here and in the shared repo and
# leaves you standing on it. The earlier version moved a ref inside the bare
# repo only, so an approve reported success over a commit `git log` did not
# have -- which is exactly how the first real run of this went.
#
# Implemented in the cave-vm binary, not here: it is host-side git and nothing
# else, so it is the first piece with no reason to stay in a shell script, and
# the first with real tests (cave-vm/internal/approve). -C, because vmcav has
# already resolved which checkout this is about.
cave_vm() {
  command -v cave-vm >/dev/null 2>&1 \
    || { log "cave-vm not found; enter the dev shell (nix develop $REPO)"; exit 1; }
  [ -d "$SHARED" ] || { log "no shared repo yet at $SHARED (vmcav start creates it)"; return 1; }
  ensure_cave_remote
  cave-vm "$1" -C "$REPO" "${@:2}"
}

# `cave` is the checkout's name for the shared repo, the same name `main`
# uses (constants::CAVE_SHARED_REMOTE), and on a machine that also runs the
# container caves it is already there pointing at this same directory.
#
# Only ever added, never repointed: if something else owns that name, saying
# so is the whole of this function's business. vmcav is what knows where the
# shared repo lives, so the remote is added here rather than in the binary.
ensure_cave_remote() {
  local repo="${1:-$REPO}" shared url
  shared=$(shared_repo_of "$repo")
  url=$(git -C "$repo" remote get-url cave 2>/dev/null || true)
  [ -n "$url" ] && return 0
  git -C "$repo" remote add cave "$shared" || return 1
  log "added the 'cave' remote -> $shared"
}

# The control plane: everything routine the host asks a running guest. Separate
# from cave_vm above because that one is host-side git and takes -C; this takes
# the state dir and talks to the VM.
guest_rpc() { cave-vm guest --state "$STATE_DIR" "$@"; }

# Terminal state is the caller's, and a remote full-screen program is what
# wrecks it. ssh restores termios on its own clean exit and nothing else: not
# app-level state like a hidden cursor, and not at all if it dies on a signal.
# So bracket every ssh with a save and an unconditional restore, and the
# symptom stops being something you fix by hand with `tput cnorm`.
TTY_STATE=""
save_local_tty() { [ -t 0 ] && TTY_STATE=$(stty -g 2>/dev/null || true); return 0; }
restore_local_tty() {
  [ -t 0 ] || return 0
  { [ -n "$TTY_STATE" ] && stty "$TTY_STATE" 2>/dev/null; } || stty sane 2>/dev/null || true
  # cnorm needs a TERM terminfo can resolve; the literal escape is the fallback
  # for the case where it can't (TERM unset, or a name this host doesn't know).
  tput cnorm 2>/dev/null || printf '\033[?25h'
}

# ssh into the guest as root, over the vsock ProxyCommand in the config above.
guest_ssh() {
  is_running || { log "vm is not running (vmcav start)"; exit 1; }
  command -v ssh >/dev/null 2>&1 || { log "ssh not found; enter the dev shell (use flake / nix develop)"; exit 1; }
  # No NIC, so ssh rides vsock via the ProxyCommand above. The hostname is a
  # placeholder the ProxyCommand ignores. Not exec'd: when the VM is up but
  # the guest is not yet listening, CHV closes the CONNECT handshake and ssh
  # dies with a message about vsock, which says nothing about the actual
  # situation (still booting, or panicked).
  # GUEST_SSH_TTY=-T for anything whose output gets parsed: a pty rewrites
  # LF to CRLF and turns "the command printed nothing" into a bare CR.
  # The trap covers what the restore below cannot: vmcav itself interrupted
  # while ssh holds the terminal.
  save_local_tty
  trap restore_local_tty EXIT INT TERM QUIT
  local rc=0
  ssh "${GUEST_SSH_TTY:--t}" "${GUEST_SSH_OPTS[@]}" root@cave-guest "$@" || rc=$?
  restore_local_tty
  trap - EXIT INT TERM QUIT
  [ "$rc" = 255 ] && { log "the vm is running but the guest is not answering ssh"; \
    explain_unreachable_guest; \
    log "  (still booting, or it failed): tail -f $CONSOLE"; }
  return "$rc"
}

# Drive the agent: attach to the pty its cave-session@ instance holds.
# Detach with ctrl-\ , which leaves the agent running.
# Create an agent and attach to it. The project and the base branch are given
# here because here is the first moment anyone knows them: the VM boots with no
# checkout, and starting one at boot is how it used to end up on a hardcoded
# repo at whatever branch the shared repo's HEAD had frozen at.
#
# Both default to what you are standing in, which is almost always what you
# mean, and neither is remembered anywhere on the host: the guest holds the
# agent's own record of what it was created for.
# Which id a new agent gets. The root agent's is reserved and asked for by
# name; everyone else takes the lowest free number from 1 up.
#
# In use means any of the three things an agent is. Two are visible from here:
# a session the guest is running (it can be attached to) and a branch in the
# shared repo (it has pushed work nobody has landed). The third is on the
# guest's own disk -- its worktree and its home -- and outlives both of the
# others, so the guest is asked.
#
# It used to be only the first two, on the reasoning that an id whose branch
# approve deleted and whose session is gone had nothing left to collide with.
# That was wrong, and this guest is what showed it: agents 1 and 2 stopped,
# their work landed, their branches gone, and six megabytes of transcripts and
# a checked-out tree still sitting under each id. The next `vmcav agent` would
# have been handed id 1 and started as agent1 in agent 1's home -- and since
# continuing is the default, it would have resumed a conversation it had never
# had.
#
# This is not a registry invented to protect a number. It is state the guest
# already keeps and already reports, asked at the one moment it decides
# something. An id comes back when that state is gone, which is what
# `vmcav agent remove` and `vmcav gc` are for.
# The ids whose worktree or home is still on the guest's disk.
#
# Over ssh rather than the control plane because it is asked once, when an
# agent is created, and 85ms there is not worth an endpoint. A guest with no
# VM running holds nothing yet, which is the one empty answer that is true.
#
# Any other failure is reported, because the empty answer and the unreachable
# answer look identical here and only one of them means "every id is free".
# A guest too old to know the subcommand lands in that case too, and says so
# rather than quietly going back to handing out occupied ids.
occupied_agent_ids() {
  is_running || return 0
  guest_ssh "cave-guestd occupied" 2>/dev/null | tr -d '\r'
}

allocate_agent_id() {
  local want_root="$1"
  if [ -n "$want_root" ]; then
    echo "$ROOT_AGENT_ID"
    return 0
  fi
  # Asked before the list is assembled, so that a guest which cannot answer
  # stops the allocation instead of disappearing into a pipeline whose exit
  # status belongs to sort.
  local occupied
  occupied=$(occupied_agent_ids) || {
    log "could not ask the guest which agent ids it still holds, so a new"
    log "  agent might be given one that already has a home and a worktree --"
    log "  and would resume the last conversation held in it."
    log "  A guest older than this script does not know the question:"
    log "    vmcav deploy && vmcav stop && vmcav start"
    return 1
  }
  # The three sources are gathered here, because each is reached differently:
  # a session the guest is running, a worktree or home on its disk, and a
  # branch in the shared repo. What they add up to -- the lowest number
  # nothing is holding, skipping the reserved one -- is cave-vm's, where it is
  # a table rather than a grep loop over a sorted merge.
  local n
  n=$( { guest_rpc agents 2>/dev/null | awk '{print $1}'
            printf '%s\n' "$occupied"
            # A prefix, not a glob: for-each-ref's * does not cross a slash,
            # so refs/heads/agent-* matches no branch an agent has ever
            # pushed. Filtering the whole list is what the Go side does too.
            git -C "$SHARED" for-each-ref --format='%(refname:short)' \
              refs/heads/ 2>/dev/null \
              | sed -n 's|^agent-\([0-9][0-9]*\)/.*|\1|p'
          } | cave-vm free-id --root "$ROOT_AGENT_ID" --max "$MAX_AGENTS" ) || n=""
  # An ordinary agent runs as agent<n>, and those users are declared in the
  # guest's config rather than made on demand, so the pool has an end. Empty
  # means cave-vm found nothing free; the remedy is said here because it is
  # about this guest's configuration rather than about the rule.
  if [ -z "$n" ]; then
    log "no free agent id: this guest holds $MAX_AGENTS agents at once."
    # Stopping one no longer frees its id, and saying so would send you to a
    # command that changes nothing: an id is held by the home and worktree on
    # the guest's disk, which outlive the session. Removing is what releases
    # it, and it is the one that asks about unlanded work first.
    log "  Remove one (vmcav agent remove <id>), sweep the idle ones"
    log "  (vmcav gc), or raise maxAgents in guest/configuration.nix"
    log "  and redeploy."
    return 1
  fi
  echo "$n"
}

# Why the start failed, in the terminal that failed, rather than a pointer to
# a journal you would have to open a shell in the guest to read.
#
# systemd's own message ("a dependency job for cave-session@N failed") names
# the unit that could not start and never the one that stopped it, and the
# dependency is always the interesting one: a session fails at its checkout
# far more often than at itself. Read-only, and only on the failure path.
explain_session_failure() {
  local id="$1" unit
  for unit in "clone-repo@$id" "seed-agent-home@$id"; do
    GUEST_SSH_TTY=-T guest_ssh "systemctl is-failed --quiet $unit" \
      >/dev/null 2>&1 || continue
    log "$unit failed:"
    GUEST_SSH_TTY=-T guest_ssh \
      "journalctl -u $unit -n 20 --no-pager -o cat" 2>/dev/null \
      | sed 's/^/  /' >&2
  done
}

do_agent() {
  # `stop` as the first word is the verb, not a project. A project named
  # "stop" would be pathological, and the alternative is a second top-level
  # command for something that is plainly part of an agent's lifecycle.
  if [ "${1:-}" = "stop" ]; then
    shift
    do_agent_stop "$@"
    return
  fi
  if [ "${1:-}" = "remove" ]; then
    shift
    local rid="" rforce=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --force) rforce=1 ;;
        *) rid="$1" ;;
      esac
      shift
    done
    do_agent_remove "$rid" "$rforce"
    return
  fi
  # --root names the agent that is root in the guest: the one that
  # redeploys the system every other agent runs in. It is not one of the
  # numbered agents, so it holds a reserved id rather than a low one, and
  # asking for it is deliberate rather than a default you can drift into.
  #
  # --fresh asks for a blank conversation. An agent otherwise picks up where
  # it left off, because an agent is a durable thing -- an id, a worktree, a
  # branch -- and stopping and starting one is not creating another.
  #
  # --resume names a conversation. Without it an agent continues its last,
  # which is the right default and not always the one meant: the archive holds
  # every session this cave has ever had, and choosing among them was possible
  # only from inside, in claude's own picker. `vmcav sessions list` is where
  # the ids come from.
  local want_root="" want_fresh="" want_session=""
  while :; do
    case "${1:-}" in
      --root)  want_root=1;  shift ;;
      --fresh) want_fresh=1; shift ;;
      --resume) want_session="${2:-}"; shift 2 || true ;;
      --resume=*) want_session="${1#--resume=}"; shift ;;
      *) break ;;
    esac
  done
  if [ -n "$want_fresh" ] && [ -n "$want_session" ]; then
    log "--fresh and --resume ask for opposite things; name one"
    return 1
  fi
  # Checked here so a typo is answered by the command you typed rather than by
  # claude, several seconds later, inside a session you now have to leave.
  case "$want_session" in
    "") ;;
    [0-9a-fA-F]*-*-*-*-*) ;;
    *) log "'$want_session' is not a session id  (vmcav sessions list)"; return 1 ;;
  esac
  local project="${1:-$SLUG}" base="${2:-}"
  # An option this does not know is not a project. Without this the guest is
  # the one that objects, having already been told to check out a project
  # called "--help", and it objects in its own words.
  case "$project" in -*)
    log "unknown option '$project'  (vmcav agent --help)"; return 1 ;;
  esac
  if [ -z "$base" ]; then
    base=$(git -C "$REPO" symbolic-ref --quiet --short HEAD) \
      || { log "detached HEAD; name a base branch:  vmcav agent $project <branch>"; return 1; }
  fi
  case "$base" in agent-*/*)
    log "'$base' is an agent branch, not a base; naming one is what approve is for"
    return 1 ;;
  esac
  # Start it rather than refusing (docs/vm-cave-design.md phase 10). Being
  # told "the vm is not running (vmcav start)" is being told to type the
  # command that would have been typed anyway: nothing about creating an
  # agent is ambiguous when the VM is down, and there is no other thing the
  # person could have meant.
  #
  # Not silent, because booting a VM is not what was asked for and takes long
  # enough to wonder about, and not the whole of `start` either -- its closing
  # advice is to create an agent, which is what this is already doing.
  if ! is_running; then
    log "the vm is not running; starting it first"
    do_start --for-agent || return 1
  fi
  # Said before the attempt, not after it. A guest older than the checkout
  # fails here as a systemd dependency job, which names neither the version
  # nor the reason; by the time you have read that, the useful sentence is
  # one you already had.
  warn_if_guest_is_behind
  local id
  # Before the agent exists, because its first act is a TLS request and a
  # stale clock fails it in a way that names everything except the clock.
  correct_guest_clock
  id=$(allocate_agent_id "$want_root") || return 1
  # An agent that cannot publish is not worth starting.
  #
  # A guard installed by another tool refuses any push whose namespace does
  # not match the id it was handed, and a whole guest shares one id -- so
  # every agent but the one that matches is refused. Committing is what
  # publishes here, so that agent would work for hours and discover it at the
  # first push, with its work in a VM a reformat deletes.
  #
  # Checked at creation, which is the last moment it costs nothing. Only for
  # an ordinary agent: the root agent holds the id the guard was stamped with,
  # so it is the one that still works.
  if [ "$id" != "$ROOT_AGENT_ID" ] && [ -e "$SHARED/hooks/pre-receive" ] \
     && ! grep -q cave-vm-git-pre-receive "$SHARED/hooks/pre-receive"; then
    log "not starting agent $id: $SLUG's branch guard belongs to another tool,"
    log "  which refuses any agent but the one the guest is stamped as. This"
    log "  agent could commit but never publish, and a reformat would take it."
    log "  take the guard over:  vmcav init"
    return 1
  fi
  if [ "$id" = "$ROOT_AGENT_ID" ]; then
    log "agent $id (vm root): $project @ $base (pushes land on agent-$id/$base)"
  else
    log "agent $id: $project @ $base (pushes land on agent-$id/$base)"
  fi
  # Captured rather than passed through, so that a guest too old to know the
  # command gets diagnosed instead of dumping cave-guestd's usage at you. That
  # is the failure people actually hit, because a host script and the binary
  # inside the guest are two versions that move independently.
  local out rc=0 root_flag="" fresh_flag="" session_flag=""
  [ -n "$want_fresh" ] && fresh_flag=" -fresh"
  # The record has to be in the agent's home before claude looks for it, and
  # after the home exists -- which is why this is not restore_agent_sessions'
  # job below: that runs once the session is up, and by then claude has
  # already been asked to resume something that is not there.
  if [ -n "$want_session" ]; then
    session_flag=" -session $want_session"
    restore_one_session "$want_session"
  fi
  # The guest is told which kind of agent this is, once, here. It records the
  # answer in the session's environment file, and everything downstream --
  # which user the session runs as, which home gets seeded, which of the two
  # session templates starts -- reads it back from there rather than
  # inferring it from the number.
  [ -n "$want_root" ] && root_flag=" -root"
  out=$(GUEST_SSH_TTY=-T guest_ssh \
    "cave-guestd start -id $id -project $project -base $base$root_flag$fresh_flag$session_flag" 2>&1) || rc=$?
  if [ "$rc" -ne 0 ]; then
    if printf '%s' "$out" | grep -q 'usage: cave-guestd'; then
      log "the guest's cave-guestd does not know 'start', so it is older than"
      log "  this script. The guest boots what its own disk says, so:"
      log "    vmcav deploy && vmcav stop && vmcav start"
      return 1
    fi
    printf '%s\n' "$out" >&2
    explain_session_failure "$id"
    log "could not start the agent"
    return 1
  fi
  [ -n "$out" ] && printf '%s\n' "$out" >&2
  restore_agent_sessions "$id"
  do_attach "$id"
}

# Put an agent's own records into its home, now that there is one.
#
# `start` restores the whole archive, but it runs before any agent has been
# created -- it says so itself, on the next line -- so on a fresh or
# reformatted guest an ordinary agent's records arrive with no home to land in.
# The guest refuses them there rather than filing them in whichever home it has,
# because a record in another agent's picker is labelled as that agent's work.
#
# This is the moment that is fixed. `cave-guestd start` has returned, so the
# session is running, so seed-agent-home@ has run and ~/.claude exists. Only
# this agent's records, because only this agent's home is known to be there.
# Put one named record where the agent will look for it, before it looks.
#
# Ahead of the start rather than after it, which is what restore_agent_sessions
# does: by the time a session is up, claude has already been told to resume
# something and found nothing. The cost of being early is that an agent whose
# home does not exist yet cannot be restored into -- the guest refuses rather
# than filing it in somebody else's home -- and that is said here instead of
# arriving as a conversation that silently starts blank.
restore_one_session() {
  local id="$1" out
  command -v cave-vm >/dev/null 2>&1 || return 0
  out=$(cave-vm sessions -state "$STATE_DIR" restore "$id" 2>&1) && return 0
  log "could not put session $id where the agent will look for it:"
  printf '%s\n' "$out" >&2
  log "  it will start a new conversation instead"
  return 0
}

restore_agent_sessions() {
  local id="$1" out
  command -v cave-vm >/dev/null 2>&1 || return 0
  out=$(cave-vm sessions -state "$STATE_DIR" -agent "$id" restore 2>&1) \
    || log "warning: some of agent $id's records did not restore: $out"
  return 0
}

# Stop an agent and keep what it wrote. The sync matters more here than
# anywhere: an agent stopped on purpose is one whose transcript you are most
# likely to want to resume from, and stopping it is the last moment the guest
# still has it.
# The agent a command means when you did not name one. The only one running is
# not a guess; two of them is, and acting on the wrong agent is not something
# you find out about until later.
the_only_running_agent() {
  local running
  running=$(guest_rpc agents 2>/dev/null | awk '$2 == "running" {print $1}')
  case $(printf '%s\n' "$running" | grep -c .) in
    0) log "no agent is running (vmcav agent starts one)"; return 1 ;;
    1) printf '%s' "$running" ;;
    *) log "more than one agent is running; name one:"
       printf '%s\n' "$running" | sed 's/^/  agent /' >&2
       return 1 ;;
  esac
}

# Remove an agent: its worktrees and its home, and its branch once nothing is
# waiting on it.
#
# Two checks the guest cannot make, which is why they are here. Whether the
# agent is running it can answer, and does. Whether it has work nobody has
# landed is a question about the shared repo, which lives on this side: an
# agent branch ahead of its base is the only copy of that work outside the
# guest, and the worktree about to be deleted is the other one.
#
# Transcripts are banked first. They live in the home this deletes, and the
# archive is on this side, so the ordering is this side's to get right.
do_agent_remove() {
  local id="${1:-}" force="${2:-}"
  [ -n "$id" ] || { log "remove needs an agent id (vmcav agent remove <id>)"; return 1; }
  case "$id" in *[!0-9]*) log "'$id' is not an agent id"; return 1 ;; esac
  is_running || { log "the vm is not running (vmcav start)"; return 1; }

  # Unlanded work, named rather than counted: "3 commits" is a number, and
  # what you need to decide is whether you recognise them.
  local branch ahead
  branch=$(git -C "$SHARED" for-each-ref --format='%(refname:short)' \
    "refs/heads/agent-$id/*" 2>/dev/null | head -1 || true)
  if [ -n "$branch" ]; then
    local base="${branch#agent-$id/}"
    # A missing base is not an empty branch. Counting against a ref that is
    # not there fails, and reading that failure as zero would delete an agent
    # branch on the grounds that nothing could be measured -- which is the
    # case where every commit on it is unreachable from anywhere else.
    if ! git -C "$SHARED" rev-parse --verify --quiet "refs/heads/$base" >/dev/null 2>&1; then
      if [ -z "$force" ]; then
        log "agent $id is on $branch, whose base '$base' is not in the shared repo"
        log "  so there is no way to tell what on it has been landed"
        log "  remove anyway (--force), or restore $base first"
        return 1
      fi
    else
    ahead=$(git -C "$SHARED" rev-list --count "$base..$branch" 2>/dev/null || echo 0)
    if [ "$ahead" -gt 0 ] && [ -z "$force" ]; then
      log "agent $id has $ahead commit$([ "$ahead" = 1 ] || echo s) on $branch that $base does not:"
      git -C "$SHARED" --no-pager log --oneline --no-decorate "$base..$branch" 2>/dev/null \
        | sed 's/^/  /' >&2
      log "  land them (vmcav approve $id), or remove anyway (--force)"
      return 1
    fi
    fi
  fi

  # Before the home goes, because that is where they are.
  sync_sessions
  GUEST_SSH_TTY=-T guest_ssh "cave-guestd remove -id $id" || {
    log "could not remove agent $id in the guest"; return 1; }
  # The branch last: it is the record that the agent existed, and deleting it
  # is what frees the id, so it goes only once everything it named is gone.
  if [ -n "$branch" ]; then
    git -C "$SHARED" branch -D "$branch" >/dev/null 2>&1 \
      && log "deleted $branch"
  fi
  git -C "$REPO" fetch --prune cave >/dev/null 2>&1 || true
  log "agent $id removed"
}

# Reclaim the agents nobody removed by hand.
#
# An id frees itself: `allocate_agent_id` counts running sessions and pushed
# branches, so an agent that stopped and had its work landed stops occupying a
# number. Its disk does not free itself, and a worktree is a whole checkout --
# so what accumulates is not slots but gigabytes, quietly, in a VM whose disk
# is the one thing here with a hard ceiling.
#
# Every candidate goes through the same checks a named removal does, unlanded
# work included, so this can only do what you could have done one at a time.
# It lists before it acts, because a sweep that is right nine times out of ten
# is still one you want to read first.
do_gc() {
  local yes="${1:-}"
  is_running || { log "the vm is not running (vmcav start)"; return 1; }
  local candidates
  candidates=$(GUEST_SSH_TTY=-T guest_ssh \
    "cave-guestd reclaimable -older-than ${GC_AGE:-24h}" 2>/dev/null | tr -d '\r') || true
  [ -n "$candidates" ] || { log "nothing to reclaim"; return 0; }

  log "agents stopped and untouched for over ${GC_AGE:-24h}:"
  printf '%s\n' "$candidates" | while read -r id hours _; do
    [ -n "$id" ] || continue
    printf '  agent %s, last touched %s hours ago\n' "$id" "$hours" >&2
  done
  if [ -z "$yes" ]; then
    printf 'Remove them? [y/N] ' >&2
    local answer; read -r answer || answer=""
    case "$answer" in y|Y|yes|YES) ;; *) log "nothing removed"; return 1 ;; esac
  fi
  # One at a time and through the ordinary path, so an agent holding work
  # nobody landed refuses here exactly as it would if you had named it.
  local id
  while read -r id _; do
    [ -n "$id" ] || continue
    do_agent_remove "$id" || log "  agent $id kept"
  done <<EOF
$candidates
EOF
}

do_agent_stop() {
  is_running || { log "the vm is not running"; return 1; }
  local id="${1:-}"
  [ -n "$id" ] || id=$(the_only_running_agent) || return 1
  guest_rpc stop "$id" || { log "could not stop agent $id"; return 1; }
  log "agent $id stopped"
  sync_sessions
}

do_attach() {
  # Which agent, always. It used to be left off, and cave-guestd's own default
  # is 1, so `vmcav agent --root` created agent 0 and then attached to an
  # agent 1 that did not exist -- and attach starts what it cannot find, so it
  # created a second agent nobody asked for.
  local id="${1:-}"
  [ -n "$id" ] || id=$(the_only_running_agent) || return 1
  # The client sends its own size on attach and on every SIGWINCH, and the
  # session replays what the agent printed while nobody was watching, so this
  # is a plain attach with nothing to set up first. An agent that has exited
  # has its unit started again by the attach, so this always lands on a live
  # session.
  # Printed before the attach, not by the client, which says nothing ever. The
  # agent paints over the screen immediately, so this is only readable in
  # scrollback afterwards -- which is exactly when you go looking for it.
  log "attaching to agent $id; detach with ctrl-\\"
  guest_ssh "cave-guestd attach $id" || true
  # Returning here means the agent exited or you detached, and both are a
  # natural place to bank what it has written. It does not cover an agent that
  # exits with nobody attached, which is what the unit-level trigger is for.
  sync_sessions
}

# A plain root shell in the guest. No args -> interactive shell; extra args run
# as a command (e.g. `vmcav shell journalctl -u cave-session@1`).
# A root shell in the guest. With an agent named, a root shell inside that
# agent's mount namespace, which is the only place /projects means anything.
#
# Worth saying plainly, because it is the one thing about the guest that a
# plain ssh login now gets wrong. Every agent sees its own worktree at
# /projects/<slug>, and it sees it because its session unit binds one there;
# outside that namespace there is no such directory, only the real trees under
# /var/lib/coding-cave/agents/<id>. So `vmcav shell` lands somewhere /projects
# does not exist, and `vmcav shell 3` lands where it is agent 3's.
#
# nsenter against the session's own pid: the session leader is the process
# systemd started, it holds the namespace for as long as the agent is running,
# and asking systemd for it is more honest than looking for a mount by path.
# Register a project so agents can be given it.
#
# Only the project vmcav is run from is registered automatically, because that
# is the one it can infer. Any other has to be named, and naming it is all
# this does: create its shared repo, install the branch-protection hooks, and
# link it into the served directory.
#
# The guest is told about it the next time the daemon starts, so a project
# added while the VM is up needs `vmcav stop && vmcav start` before an agent
# can clone it. Said rather than worked around: restarting the daemon under a
# running guest would drop whatever push was in flight.
do_init() {
  local dir="" as="" slug
  # --as names the project, for when its directory's basename is taken or is
  # not what you want the guest to call it.
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) as="${2:-}"; shift 2 || true ;;
      --as=*) as="${1#--as=}"; shift ;;
      -*) log "unknown option '$1'  (vmcav init [dir] [--as name])"; return 1 ;;
      *) dir="$1"; shift ;;
    esac
  done
  dir="${dir:-$PWD}"
  [ -d "$dir" ] || { log "no such directory: $dir"; return 1; }
  case "$as" in
    "") ;;
    */*|.|..) log "'$as' cannot be a project name: it is one path element"; return 1 ;;
  esac
  slug=$(register_project "$dir" "$as") || return 1
  log "project '$slug' registered ($(project_target "$slug"))"
  if is_running; then
    if restart_git_daemon; then
      log "  the guest can reach it now"
    else
      log "  the guest cannot reach it until the daemon is restarted:"
      log "    vmcav stop && vmcav start"
    fi
  fi
  log "  give it to an agent with: vmcav agent $slug <branch>"
}

# Stop serving a project to the guest.
#
# Unregistering, not deleting: the link goes and the project's own shared repo,
# which lives inside the project and holds every agent branch pushed to it,
# stays exactly where it was. Removing a project must not be a way to lose
# work, and the cheapest way to guarantee that is not to touch anything that
# holds any.
#
# Refused while an agent still has a worktree of it, because unregistering one
# out from under an agent leaves that agent holding a checkout it can no longer
# clone or fetch -- a worse state than either having the project or not. The
# question of whether that agent is safe to remove is not re-decided here:
# `vmcav agent remove` already asks it, unlanded work and all, so this points
# at that rather than growing a second opinion.
do_remove_project() {
  local slug="${1:-}"
  [ -n "$slug" ] || { log "remove-project needs a project name (vmcav projects)"; return 1; }
  [ -L "$REPOS/$slug.git" ] || { log "'$slug' is not registered (vmcav projects)"; return 1; }

  if is_running; then
    local held
    held=$(GUEST_SSH_TTY=-T guest_ssh "cave-guestd holders -project $slug" 2>/dev/null \
      | tr -d '\r') || true
    if [ -n "$held" ]; then
      log "agents still have a worktree of '$slug':"
      printf '%s\n' "$held" | while read -r id state; do
        [ -n "$id" ] || continue
        printf '  agent %s (%s)\n' "$id" "$state" >&2
      done
      log "  remove them first (vmcav agent remove <id>), which checks their work"
      return 1
    fi
  else
    log "the vm is not running, so nothing can be asked about agent worktrees"
    log "  unregistering anyway; an agent holding one finds it gone at next start"
  fi

  rm -f "$REPOS/$slug.git"
  log "'$slug' unregistered; its repo and history are untouched at $REPO"
  is_running && log "  the guest stops seeing it after a restart: vmcav stop && vmcav start"
  return 0
}

# What the guest can reach, and where each one really is.
# The cave environment's spec, on this side. Beside config.toml, which is
# where `main` keeps it too, so a dotfiles repo that already manages one
# manages this without being told anything new.
ENV_SPEC="${CODING_CAVE_ENV:-$(dirname "$CONFIG")/cave.nix}"
# And on the guest's side, where cave-env builds it from.
GUEST_ENV_SPEC=/var/lib/coding-cave/env/cave.nix

# Carry the environment spec across the boundary, in whichever direction is
# asked for.
#
# Until now it could not cross at all. The guest half of phase 9 builds an
# environment from `/var/lib/coding-cave/env/cave.nix` and `cave-env edit`
# writes it, so a spec written in a cave lived in that cave and nowhere else
# -- one `reformat` from never having existed, and impossible to commit to the
# dotfiles repo that manages every other machine's configuration.
#
# Two directions rather than one, because neither side is the author. A person
# edits this on the host with the rest of their configuration; an agent edits
# it in the guest because that is where it can be built and tried. So `pull`
# takes what the guest has and `push` sends what the host has, and each
# refuses to overwrite a file that differs unless told twice.
#
# Over ssh rather than the control plane. The plane exists and is cheaper, but
# it is worth an endpoint only for what is asked on every command; this is
# asked when somebody changes their environment. The host names both paths, so
# nothing the guest says decides where a byte lands.
do_env() {
  local action="${1:-show}" force="${2:-}"
  case "$action" in
    pull|push|show) ;;
    *) log "usage: vmcav env [show|pull|push] [--force]"; return 1 ;;
  esac
  is_running || { log "the vm is not running (vmcav start)"; return 1; }

  local guest_spec host_spec="" rc=0
  guest_spec=$(GUEST_SSH_TTY=-T guest_ssh "cat $GUEST_ENV_SPEC 2>/dev/null") || rc=$?
  [ -f "$ENV_SPEC" ] && host_spec=$(cat "$ENV_SPEC")

  case "$action" in
    show)
      log "host:  $ENV_SPEC${host_spec:+ ($(printf '%s' "$host_spec" | wc -l) lines)}"
      log "guest: $GUEST_ENV_SPEC${guest_spec:+ ($(printf '%s' "$guest_spec" | wc -l) lines)}"
      if [ -z "$guest_spec" ] && [ -z "$host_spec" ]; then
        log "neither side has one; the cave defaults apply"
      elif [ "$guest_spec" = "$host_spec" ]; then
        log "they agree"
      else
        log "they differ: vmcav env pull (keep the guest's) or push (keep this one)"
      fi
      return 0
      ;;
    pull)
      [ -n "$guest_spec" ] || { log "the guest has no $GUEST_ENV_SPEC to pull"; return 1; }
      if [ "$guest_spec" = "$host_spec" ]; then
        log "already the same; nothing to pull"
        return 0
      fi
      if [ -n "$host_spec" ] && [ "$force" != "--force" ]; then
        log "$ENV_SPEC differs from the guest's and would be overwritten"
        log "  keep it and send it instead:  vmcav env push"
        log "  take the guest's anyway:      vmcav env pull --force"
        return 1
      fi
      mkdir -p "$(dirname "$ENV_SPEC")"
      printf '%s\n' "$guest_spec" > "$ENV_SPEC"
      log "pulled the guest's spec to $ENV_SPEC"
      log "  it is configuration; commit it wherever your dotfiles live"
      ;;
    push)
      [ -n "$host_spec" ] || { log "there is no $ENV_SPEC to push"; return 1; }
      if [ "$guest_spec" = "$host_spec" ]; then
        log "already the same; nothing to push"
        return 0
      fi
      if [ -n "$guest_spec" ] && [ "$force" != "--force" ]; then
        log "the guest's spec differs from this one and would be overwritten"
        log "  keep the guest's instead:  vmcav env pull"
        log "  overwrite it anyway:       vmcav env push --force"
        return 1
      fi
      # The directory first. It is made by `cave-env edit` and by a build, so
      # a guest where neither has run does not have one -- which is exactly
      # the guest you would push a spec to, the one with no environment yet.
      # Without this the redirect fails and the whole report is the shell's:
      # "No such file or directory", naming a path and nothing else.
      printf '%s\n' "$host_spec" \
        | GUEST_SSH_TTY=-T guest_ssh \
            "install -d -m 755 ${GUEST_ENV_SPEC%/*} && cat > $GUEST_ENV_SPEC" || {
          log "could not write the spec into the guest"; return 1; }
      log "pushed $ENV_SPEC into the guest"
      # Built here rather than left for the next session, because a spec that
      # does not build is worth finding out about while you are still looking
      # at the command that sent it.
      GUEST_SSH_TTY=-T guest_ssh "cave-env build" || {
        log "the spec is in the guest but did not build; fix it and retry:"
        log "  vmcav shell, then cave-env edit"
        return 1; }
      ;;
  esac
  return 0
}

# The values a completion needs that are not fixed strings: which agents
# exist and which projects are registered. A hidden subcommand rather than a
# library, because the completion script is a different language in a
# different process and the only thing it can call is this one.
#
# Never fails and never blocks on a guest. A completion that takes a second to
# offer nothing is worse than one that offers nothing immediately, and a shell
# that prints an error where a list should be is worse than both.
do_complete() {
  case "${1:-}" in
    commands)
      printf '%s\n' start stop status agent attach deploy review approve \
        reject push init projects remove-project gc env shell version image \
        completion cp
      ;;
    agents)
      # Both kinds. A stopped agent is exactly what `attach` is for, and
      # `agent remove` takes nothing else.
      is_running 2>/dev/null && guest_rpc agents 2>/dev/null | awk '{print $1}'
      ;;
    projects) registered_projects 2>/dev/null ;;
    bases)
      # Base branches, which is every branch that is not an agent's.
      git -C "$REPO" for-each-ref --format='%(refname:short)' refs/heads/ \
        2>/dev/null | grep -v '^agent-[0-9]*/' || true
      ;;
  esac
  return 0
}

# Shell completion. Both scripts call `vmcav __complete <what>` for anything
# that is not a fixed list, so the two stay in step with the tool rather than
# with each other: a command added below is offered by both without either
# script being edited.
do_completion() {
  case "${1:-}" in
    bash) cat <<'BASH'
_vmcav() {
  local cur prev words cword
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  local cmd="${COMP_WORDS[1]}"
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "$(vmcav __complete commands)" -- "$cur"))
    return
  fi
  case "$cmd" in
    attach)  COMPREPLY=($(compgen -W "$(vmcav __complete agents)" -- "$cur")) ;;
    agent)
      case "$prev" in
        stop|remove) COMPREPLY=($(compgen -W "$(vmcav __complete agents)" -- "$cur")) ;;
        agent)       COMPREPLY=($(compgen -W "stop remove --root --fresh $(vmcav __complete projects)" -- "$cur")) ;;
        *)           COMPREPLY=($(compgen -W "$(vmcav __complete bases)" -- "$cur")) ;;
      esac ;;
    remove-project) COMPREPLY=($(compgen -W "$(vmcav __complete projects)" -- "$cur")) ;;
    env)     COMPREPLY=($(compgen -W "show pull push --force" -- "$cur")) ;;
    image)   COMPREPLY=($(compgen -W "create reformat" -- "$cur")) ;;
    push)    COMPREPLY=($(compgen -W "--force $(vmcav __complete bases)" -- "$cur")) ;;
    review|approve|reject) COMPREPLY=($(compgen -W "$(vmcav __complete agents)" -- "$cur")) ;;
    init)    COMPREPLY=($(compgen -d -- "$cur")) ;;
    gc)      COMPREPLY=($(compgen -W "-y" -- "$cur")) ;;
  esac
}
complete -F _vmcav vmcav
BASH
      ;;
    zsh) cat <<'ZSH'
#compdef vmcav
_vmcav() {
  local -a cmds
  if (( CURRENT == 2 )); then
    cmds=(${(f)"$(vmcav __complete commands)"})
    _describe 'command' cmds
    return
  fi
  case "$words[2]" in
    attach) _values 'agent' ${(f)"$(vmcav __complete agents)"} ;;
    agent)
      if (( CURRENT == 3 )); then
        _values 'project' stop remove --root --fresh ${(f)"$(vmcav __complete projects)"}
      elif [[ "$words[3]" == (stop|remove) ]]; then
        _values 'agent' ${(f)"$(vmcav __complete agents)"}
      else
        _values 'branch' ${(f)"$(vmcav __complete bases)"}
      fi ;;
    remove-project) _values 'project' ${(f)"$(vmcav __complete projects)"} ;;
    env)   _values 'action' show pull push --force ;;
    image) _values 'action' create reformat ;;
    push)  _values 'branch' --force ${(f)"$(vmcav __complete bases)"} ;;
    review|approve|reject) _values 'agent' ${(f)"$(vmcav __complete agents)"} ;;
    init)  _path_files -/ ;;
    gc)    _values 'flag' -y ;;
  esac
}
_vmcav "$@"
ZSH
      ;;
    *)
      log "usage: vmcav completion {bash|zsh}"
      log "  bash:  eval \"\$(vmcav completion bash)\"  in ~/.bashrc"
      log "  zsh:   vmcav completion zsh > ~/.zfunc/_vmcav   (with ~/.zfunc in \$fpath)"
      return 1
      ;;
  esac
}

# Copy files in or out of a cave.
#
# The transport was already here -- scp rides the same ssh config as `vmcav
# shell`, over the vsock ProxyCommand -- and what was missing was being able
# to say where. An agent's files are not at a path a human knows: its worktree
# is under ${worktreeRoot}/<id>/projects/<slug>, which is a layout nobody
# should have to hold, and inside its own namespace the same tree is
# /projects/<slug>, which is not a path the host can name.
#
# So `cave:` means "in the agent's tree", and the id is resolved the way every
# other command resolves it: the only running agent needs no name, and two of
# them is not guessed at.
#
#   vmcav cp cave:notes.md .          out of the agent's worktree
#   vmcav cp cave:~/.claude/x .       out of its home
#   vmcav cp data.csv cave:           in, to the worktree
#   vmcav cp cave@2:log.txt .         when more than one agent is running
#
# Overwrites without asking, which scp does and `main` does not: a prompt
# needs to know whether the far side exists, and that is a second round trip
# for a question the shell can answer about the near side only. Said here
# because it is a difference somebody will meet.
WORKTREE_ROOT="${WORKTREE_ROOT:-/var/lib/coding-cave/agents}"

do_cp() {
  [ $# -ge 2 ] || { log "usage: vmcav cp <src>... <dst>   (cave:PATH for the agent's side)"; return 1; }
  is_running || { log "the vm is not running (vmcav start)"; return 1; }

  # One id for the whole command. Copying between two agents is a different
  # operation and naming two would make every argument ambiguous.
  local id="" spec seen=""
  for spec in "$@"; do
    case "$spec" in
      cave@*:*) seen="${spec#cave@}"; seen="${seen%%:*}" ;;
      cave:*)   seen="${seen:-any}" ;;
      *) continue ;;
    esac
    case "$seen" in
      any) ;;
      *[!0-9]*|"") log "'$spec' does not name an agent  (cave@<id>:path)"; return 1 ;;
      *) [ -n "$id" ] && [ "$id" != "$seen" ] && {
           log "one command, one agent: '$id' and '$seen' both named"; return 1; }
         id="$seen" ;;
    esac
  done
  [ -n "$seen" ] || { log "neither side is in the cave; this is just cp"; return 1; }
  [ -n "$id" ] || id=$(the_only_running_agent) || return 1

  # Which project's worktree a relative path is relative to. The guest is the
  # register of what an agent was created for, and it is the same answer
  # `status` prints.
  local project
  project=$(guest_rpc agents 2>/dev/null | awk -v i="$id" '$1 == i {print $3}' | head -1)
  case "$project" in
    ""|"-") project="" ;;
  esac

  # Rewritten here rather than by scp, so the guest layout stays on this side
  # of the boundary and the agent never has to be told where it lives.
  local -a args=()
  local rest
  for spec in "$@"; do
    case "$spec" in
      cave@*:*) rest="${spec#*:}" ;;
      cave:*)   rest="${spec#cave:}" ;;
      *)        args+=("$spec"); continue ;;
    esac
    # Where that lands is the guest's layout, which cave-vm holds: an agent's
    # worktree is <root>/<id>/projects/<slug>, and leaving the slug out of it
    # put every relative copy one directory too high.
    #
    # A relative address needs a project to be relative to, and a failure here
    # is that and only that: absolute paths and ~ need none, so an agent whose
    # project the guest cannot name is still reachable by them.
    local guest
    guest=$(cave-vm guest-path --id "$id" --project "$project" \
              --root "$ROOT_AGENT_ID" --worktrees "$WORKTREE_ROOT" -- "$rest") || {
      log "the guest does not say which project agent $id has, so '$rest'"
      log "  has nothing to be relative to; name a path from / instead"
      return 1; }
    args+=("cave-guest:$guest")
  done
  scp -q -r -F "$SSHCONF" "${args[@]}"
}

do_projects() {
  # Listed by cave-vm, which also builds the daemon's whitelist from the same
  # read. They were two pieces of shell over the same directory and they
  # disagreed: the listing showed a moved project with a blank column, and the
  # whitelist handed that dead path to the daemon anyway.
  cave-vm projects --state "$STATE_DIR"
}

project_target() {
  readlink "$REPOS/$1.git" 2>/dev/null || true
}

do_shell() {
  local agent=""
  case "${1:-}" in
    [0-9]*) agent="$1"; shift ;;
  esac
  if [ -z "$agent" ]; then
    guest_ssh "$@"
    return
  fi
  # cave-enter lives in the guest, because which namespace an agent holds and
  # where its trees really are is the guest's own layout: a host script that
  # knew it would be a second copy of the same fact, drifting.
  guest_ssh "cave-enter $agent" "$@"
}

# The commit this vmcav was built from. The nix wrapper bakes it in, because
# an installed copy is a store path that can be older than the checkout it is
# being run from; running from a source tree there is nothing baked, so HEAD
# stands in. The date comes from the commit itself, so it says when the code
# was written rather than when it was installed.
do_version() {
  local rev="${CAVE_VMCAV_REV:-}"
  [ -n "$rev" ] || rev=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)
  [ -n "$rev" ] || { echo "vmcav unknown"; return 0; }
  local short=${rev:0:7} date
  # format-local, not format: the commit carries the timezone of whoever made
  # it, and an agent in a cave commits in UTC. You want your own clock.
  date=$(git -C "$REPO" log -1 --format=%cd --date='format-local:%Y-%m-%d %H:%M' \
    "${rev%-dirty}" 2>/dev/null || true)
  local dirty=""; case "$rev" in *-dirty) dirty=" dirty" ;; esac
  echo "vmcav $short$dirty ${date:-(commit not in $REPO)}"
  local head; head=$(git -C "$REPO" rev-parse --short=7 HEAD 2>/dev/null || true)
  [ -n "$head" ] && [ "$head" != "$short" ] && \
    echo "checkout is at $head -- nix profile upgrade vmcav"
  return 0
}

usage() {
  cat <<'EOF'
usage: vmcav <command>

  start           boot the VM detached (idempotent; needs an image)
  stop            ACPI power-down, SIGTERM/SIGKILL fallback
  status          whether it is up, which generation, where the console is
  agent [--root] [--fresh] [proj] [branch]
                  create an agent for a project and attach (detach: ctrl-\)
                  --root is the agent that is root in the guest, agent 0
                  an agent continues its last conversation; --fresh starts one
                  --resume ID picks one instead (vmcav sessions list)
                  starts the vm first if it is not running
  agent stop [id] stop an agent and bank its transcript
  agent remove id reclaim a stopped agent: its worktrees, home and branch
                  (--force removes one with work nobody has landed)
  attach [id]     reattach to an agent already running (detach: ctrl-\)
  init [dir] [--as name]
                  register a project so agents can be given it (default: cwd)
                  --as names it, for when two directories share a basename
  projects        list the projects the guest can reach
  remove-project slug
                  stop serving a project (its repo and history are untouched)
  gc [-y]         remove agents stopped and untouched for over 24h
  completion bash|zsh
                  a completion script for that shell, on stdout
  cp src... dst   copy files in or out; cave:PATH is the agent's side
                  (cave:~/... its home, cave@2:... a particular agent)
  env [show|pull|push]
                  the cave environment's spec (cave.nix): what each side has,
                  or carry it across (--force to overwrite one that differs)
  shell [cmd...]  a root shell in the guest, or run cmd there
  deploy          build the guest config and activate it in the running VM
  push [branch]   send this checkout's branch to the shared repo the agent
                  clones from (--force to move it non-fast-forward)
  review [agent]  check out what the agent has pushed and not had landed
  approve [agent] land it on the base branch, here and in the shared repo
                  --commit SHA lands only that far, leaving the rest pending
  reject [base]   take back the last landing on a base branch, putting the
                  work back on the agent branch it came from
  version         the commit this vmcav was built from
  image create    build the guest and create its disk
  image reformat  destroy that disk and build a new one

  Any command takes --help:  vmcav agent --help
EOF
}

# One command's entry out of the table above, so a command is described in one
# place and `vmcav agent --help` reads that rather than a second copy that
# drifts out of step with it. An entry is every line whose first word is the
# command, plus the continuation lines indented under them.
help_for() {
  usage | awk -v c="$1" '
    $1 == c { show = 1; print; next }
    show && /^ {16}/ { print; next }
    show { exit }
  '
}

# Build the guest and materialize its disk. Everything that needs nix lives
# here, so `start` is only ever a boot: the three artifacts the cmdline names
# are kept as out-links, which are gc roots, so the store cannot collect the
# system the disk is running out from under it.
# Build guest artifacts into out-links under $dir. Out-links are gc roots, so
# whatever the host is prepared to boot cannot be collected out from under it.
# $1 is where they go, the rest are the flake outputs to build.
# Which of the guest flake's systems to build, from the machine this runs on.
#
# The guest is Linux either way; what changes is the architecture, because a VM
# runs the host's. x86_64 under Cloud Hypervisor, aarch64 under vfkit on Apple
# silicon -- and `uname -m` says arm64 there and aarch64 on Linux, which is the
# same machine by two names.
#
# It was `packages.x86_64-linux` written out, which is right on the only host
# this has ever run on and silently wrong on the other: an Apple silicon host
# would build an x86_64 guest and hand it to a VMM that cannot boot it. The
# flake has offered both systems for a while; only the caller was pinned.
guest_system() {
  case "$(uname -m)" in
    arm64|aarch64) echo aarch64-linux ;;
    x86_64|amd64)  echo x86_64-linux ;;
    *) log "no guest is built for a $(uname -m) host"; return 1 ;;
  esac
}

build_guest() {
  local dir="$1"; shift
  mkdir -p "$SEED"
  stage_seed
  # The guest bakes crinj's CA into its system trust store at build time, so
  # the PEM must be present at eval; pass it via env (the build is --impure).
  export CODING_CAVE_CRINJ_CA; CODING_CAVE_CRINJ_CA=$(cat "$SEED/ca.pem")
  export CAVE_VM_SRC
  log "building guest from $GUEST_FLAKE"
  local a system
  system=$(guest_system) || return 1
  for a in "$@"; do
    nix build --impure --extra-experimental-features 'nix-command flakes' \
      --out-link "$dir/$a" "$GUEST_FLAKE#packages.$system.$a" || return 1
  done
}

do_image_create() {
  require_tools
  [ -f "$DISK" ] && { log "image exists at $DISK (vmcav image reformat to replace it)"; return 1; }
  build_guest "$BOOT" kernel initrd disk toplevel || return 1
  local disk_mb; disk_mb=$(config_disk_mb)
  log "creating guest disk (cap $((disk_mb / 1024)) GB, sparse)"
  # In cave-vm, because this was `cp --sparse=always` and `truncate -s`: two
  # GNU coreutils, neither of them on a Mac. Sparseness is not a nicety here.
  # The built image is a few hundred megabytes and the cap is a hundred
  # gigabytes, so a dense copy would cost the whole cap on disk the day the
  # guest is made.
  cave-vm disk -from "$BOOT/disk/nixos.img" -to "$DISK" -size-mb "$disk_mb" || return 1
  record_deployed_from
  log "image ready; vmcav start"
}

# Re-bootstrap. Updating a guest is an in-guest nixos-rebuild, which needs a
# working agent in a working VM; when that is what is broken, the way out is
# the cattle property (docs/vm-root-agent.md): destroy the disk and let the
# host build the whole system from the spec ref, needing nothing inside.
#
# Destroy and recreate, so the disk being the only copy of everything the
# guest has done makes this the one command that throws work away. Its own
# command rather than a flag on start for that reason: nothing that destroys
# a filesystem should be reachable by adding a word to the command you run
# every day.
do_image_reformat() {
  if [ -f "$DISK" ]; then
    echo "This destroys the guest's entire filesystem:" >&2
    echo "  $DISK ($(du -h "$DISK" 2>/dev/null | cut -f1) used)" >&2
    echo "  its nix store, /root/coding-cave and any uncommitted work in it," >&2
    echo "  and the agent's session history." >&2
    echo "It is rebuilt from $GUEST_FLAKE as it stands right now." >&2
    echo "Whatever the agent pushed survives in the repo, as does its login." >&2
    printf 'Destroy it? [y/N] ' >&2
    local answer; read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) log "aborted"; return 1 ;;
    esac
  fi
  # The login lives on the disk about to be destroyed, and a running guest is
  # the only place to read it. This is the one sequence that needs it, so it
  # is the only one that takes it: `stop` and a detach from `agent` are not
  # about to throw anything away and have no business reaching into the guest.
  # Stopping is ours to do rather than yours: refusing to run because the VM
  # is up would mean stopping it first, which is exactly when the login
  # becomes unreadable.
  if is_running; then
    capture_guest_credentials; capture_guest_config
    do_stop
  fi
  # After the stop, not before: with the VM down this reads the transcripts
  # straight off the image, which needs nothing of the guest and so also works
  # for the guest you are most likely to be reformatting, the one that stopped
  # answering. Last thing before the disk goes.
  sync_sessions
  rm -f "$DISK"
  do_image_create
}

# Copy the guest's session transcripts into the host's record. Cheap when
# nothing has grown, since only records the host lacks or that got longer are
# fetched at all, so this can be called at every moment that might be the last
# one: a stop, a detach, and above all a reformat, which is the only command
# that destroys the guest's copy.
#
# Never fatal. It runs immediately before something the user asked for, and
# refusing to stop or reformat because a transcript would not copy would be
# the tool holding its own bookkeeping over the user's instruction.
sync_sessions() {
  command -v cave-vm >/dev/null 2>&1 || return 0
  # `|| rc=$?` rather than a bare assignment: under set -e a failing command
  # substitution takes the whole script with it, and this must never be the
  # reason a stop or a reformat does not happen.
  local out rc=0
  # A running guest answers over the control plane; a stopped one is read
  # straight off its disk image. The second is what makes `reformat` safe: the
  # guest you are most likely to reformat is one too broken to answer, and it
  # is about to be deleted. Never both, because reading a live filesystem
  # gives torn data.
  if is_running; then
    out=$(cave-vm sessions -state "$STATE_DIR" sync 2>&1) || rc=$?
  elif [ -f "$DISK" ]; then
    out=$(cave-vm sessions -disk "$DISK" sync 2>&1) || rc=$?
  else
    return 0
  fi
  if [ "$rc" -ne 0 ]; then
    log "warning: some session records did not copy out:"
    printf '%s\n' "$out" >&2
    return 0
  fi
  [ -n "$out" ] && log "session records: $(printf '%s\n' "$out" | grep -c .) updated"
  return 0
}

# Put an agent's own records back where its picker will find them, and every
# record where any agent can read it. At start, because `/resume` happens
# inside the cave with the host not consulted, so what is not on disk when
# claude launches does not exist as far as the agent is concerned.
restore_sessions() {
  command -v cave-vm >/dev/null 2>&1 || return 0
  is_running || return 0
  local out
  # A refusal here is expected rather than a fault on a guest whose homes do
  # not exist yet: those records are placed when their agent is created, by
  # restore_agent_sessions. Said plainly, because "did not restore" on its own
  # reads as lost work.
  out=$(cave-vm sessions -state "$STATE_DIR" restore 2>&1) \
    || log "records belonging to agents that do not exist yet are held back; each lands when its agent is created"
  out=$(cave-vm sessions -state "$STATE_DIR" share 2>&1) \
    || log "warning: the shared session view is incomplete: $out"
  return 0
}

# Change what a running VM runs, without destroying it. The inside half of
# this is the agent's own `nixos-rebuild switch`; this is the outside half,
# for when the change is yours rather than the agent's, or when the agent is
# not in a state to make it.
#
# Ordering is the whole design. The closure goes into the guest first, so that
# by the time the host's out-links name the new system the guest already has
# it: a deploy that dies during activation still leaves a VM that boots, on
# the system that was deployed. The other order points the host's cmdline at a
# toplevel the guest's store has never seen, which fails at boot with nothing
# to fall back to.
do_deploy() {
  require_tools
  is_running || { log "the vm is not running; deploy needs a live guest (vmcav start)"; return 1; }
  guest_ready || {
    log "the vm is running but the guest is not answering ssh"
    explain_unreachable_guest
    return 1; }

  # Built beside the live out-links, not over them: until the guest has the
  # closure, the host must keep pointing at the system the guest still has.
  local staging="$STATE_DIR/boot.next"
  build_guest "$staging" kernel initrd toplevel || return 1
  local toplevel; toplevel=$(readlink -f "$staging/toplevel")
  local current
  current=$( (GUEST_SSH_TTY=-T guest_ssh readlink -f /run/current-system) 2>/dev/null \
    | tr -d '\r' || true)
  if [ "$toplevel" = "$current" ]; then
    # Already running it is not already deployed.
    #
    # This is the ordinary state after `cave-rebuild` in the guest: same
    # source, same closure, so the running system is exactly what this would
    # build. What is not the same is what the host boots -- an in-guest
    # rebuild moves the running system and nothing else, which the guest's own
    # CLAUDE.md says and which is the entire reason this command exists.
    #
    # Returning here left the boot pointer on the generation before, so the
    # next `vmcav stop && vmcav start` reverted work that had been deployed,
    # tested and reported as live. Nothing said so: the message was about the
    # thing that was already true.
    build_guest "$BOOT" kernel initrd toplevel || return 1
    rm -rf "$staging"
    log "the guest was already running this system; the host now boots it too"
    return 0
  fi

  # --no-check-sigs because the host built these paths itself and the guest has
  # no reason to trust this host's signature over the channel that delivered
  # it: the transport is a socket only we can open, into a VM we own.
  log "copying the closure into the guest"
  NIX_SSHOPTS="-F $SSHCONF" nix copy --to ssh://cave-guest --no-check-sigs \
    --extra-experimental-features 'nix-command flakes' "$toplevel" || return 1

  # Ask what the activation would do before letting it do it.
  #
  # This is the same check `cave-rebuild` makes inside the guest, made here
  # too because this is the other door onto the same operation: both ends run
  # `switch-to-configuration switch`, so both can stop a live session and kill
  # the agent in it. That is not hypothetical -- it happened three times from
  # the in-guest side, each one taking the terminal with it and leaving the
  # switch dead half-applied. A deploy from the host would have done the same
  # thing to whoever was working in there, with the additional charm that the
  # person who lost their agent is not the person who typed the command.
  #
  # Cheap here: the closure is already in the guest, so this is a plan against
  # paths that exist and not another build. Before $BOOT moves, so that a
  # refusal leaves the host still pointing at the system the guest is running.
  log "checking the activation plan"
  local plan risky
  plan=$(GUEST_SSH_TTY=-T guest_ssh \
    "$toplevel/bin/switch-to-configuration dry-activate" 2>&1 | tr -d '\r') || {
    log "could not plan the activation:"
    printf '%s\n' "$plan" | sed 's/^/  /' >&2
    return 1
  }
  # "would NOT stop the following changed units:" is the line that says a
  # session is safe; anchoring on the exact prefixes keeps it from reading as
  # the one that says it is not.
  risky=$(printf '%s\n' "$plan" \
    | grep -E '^would (stop|restart) the following' \
    | grep -oE 'cave-(root-)?session@[^ ,]+' || true)
  if [ -n "$risky" ]; then
    log "this deploy would stop or restart a live agent session:"
    printf '%s\n' "$risky" | sed 's/^/  /' >&2
    log "  That kills the agent running in it. Nothing has been activated and"
    log "  the guest still boots what it is running."
    log "  Usually a unit a session Requires= is being removed, or has become"
    log "  RemainAfterExit: leave a no-op behind for one generation instead."
    log "  See the seed-claude-config tombstone in guest/configuration.nix."
    return 1
  fi

  # Only now is it safe to say this is what the host boots.
  local old_kernel; old_kernel=$(readlink -f "$BOOT/kernel" 2>/dev/null || true)
  build_guest "$BOOT" kernel initrd toplevel || return 1
  rm -rf "$staging"

  log "activating"
  # The profile first, so the generation exists whether or not activation
  # succeeds and `nixos-rebuild switch --rollback` in the guest has something
  # to go back to.
  GUEST_SSH_TTY=-T guest_ssh \
    "nix-env -p /nix/var/nix/profiles/system --set $toplevel \
     && $toplevel/bin/switch-to-configuration switch" || {
    log "activation failed; the guest still has the closure and boots it on restart"
    return 1
  }

  if [ "$old_kernel" != "$(readlink -f "$BOOT/kernel")" ]; then
    log "the kernel changed; the guest is running the old one until a restart"
    log "  (vmcav stop && vmcav start)"
  fi
  record_deployed_from
  log "deployed"
}

shortrev() { git -C "$REPO" rev-parse --short "$1" 2>/dev/null || printf '%s' "${1:0:7}"; }

# What the guest was last built from. The guest boots what its own disk says,
# so pulling on the host changes nothing in it until a deploy, and nothing used
# to say so: the symptom was old guest behaviour with a current `vmcav
# version`, which reports the host script and not the guest.
#
# The commit rather than a store path, because the question being answered is
# "is the guest behind my checkout", and a store path cannot answer that
# without a build.
#
# HEAD alone is half an answer, though, because the build reads the working
# tree and not a commit. A deploy with guest/ or cave-vm/ dirty produces a
# guest that no commit describes, and recording the bare commit made that read
# back as an exact match: status went quiet about the one guest whose contents
# nothing on the host records. Hence the `-dirty` suffix, the same marker
# `version` already uses for the same reason.
#
# Scoped to the two paths the build actually reads. Whole-repo dirt would stand
# while any doc or script was edited, which is most of the time, and a warning
# that is always on is one nobody reads.
guest_source_rev() {
  local rev; rev=$(git -C "$REPO" rev-parse HEAD 2>/dev/null) || return 1
  # --porcelain rather than `diff --quiet`, so an untracked file counts: the
  # build copies the directory, so a file git has never seen is still an input.
  [ -z "$(git -C "$REPO" status --porcelain -- guest cave-vm 2>/dev/null)" ] \
    || rev="$rev-dirty"
  printf '%s' "$rev"
}

record_deployed_from() {
  local rev; rev=$(guest_source_rev) || return 0
  # Through a temp file: a plain redirect truncates before git runs, so a
  # rev-parse that failed destroyed a good record and left an empty one, after
  # which the check below read no record and stayed silent for good.
  printf '%s\n' "$rev" > "$STATE_DIR/deployed-from.tmp" \
    && mv "$STATE_DIR/deployed-from.tmp" "$STATE_DIR/deployed-from"
}

# Say so when the guest is not what the checkout would build. A hint rather
# than a verdict: the comparison is by commit, so a commit touching only docs
# lands here too, and erring toward "deploy" costs a rebuild that is mostly
# cached.
# Say when the branch guard on a project's shared repo is not the one this
# tool installs.
#
# Written because the alternative is what happened: the guard was corrected,
# the correction never reached the repo in use, and nothing anywhere said so.
# Every push kept being refused by a hook belonging to a different tool, which
# looks exactly like the guard working, and it took four rounds of fixing the
# wrong file to notice. A misconfiguration that produces a plausible refusal is
# the kind worth spending a check on.
#
# Only warns. Status must not change what it is reporting on, and the repair is
# one command, named here so it does not have to be looked up.
# Put the guest's clock right, if it has drifted enough to matter.
#
# The guest has no NIC, no NTP and no timesyncd. It takes the clock from the
# host when it boots and nothing touches it afterwards, so on a host that
# suspends -- every laptop -- it wakes behind by however long the lid was
# shut. Under HVF on aarch64 the counter does not track the host at all.
#
# What that costs is out of proportion to the cause. A stale clock fails TLS
# certificate validation, so every request an agent makes fails, and nothing
# in that failure mentions the time. ssh keeps working, because host keys
# carry no dates, so the channel you would use to investigate is the one thing
# that still behaves.
#
# Corrected here rather than by a timer in the guest, which would need a clock
# it has no reason to trust, and rather than by a resume hook, which would
# need the host to notice its own suspend. Every host-to-guest command is the
# cheapest trigger there is, and it bounds staleness by "when you last asked"
# -- the same rule the session sync already follows.
#
# Quiet below the threshold, because a call costs a couple of milliseconds and
# reporting that as drift would make every command noisy.
# Best-effort, and silent about its own failure. This runs on every command
# that reaches the guest, so a control plane that is briefly unreachable must
# not put an error on each one -- and it would be reporting something the rest
# of the command is about to report properly. Only a correction is worth a
# line, because a correction means the guest was wrong about the time and an
# agent may have been failing because of it.
# Carry the human's commits on the current base into the shared repo, which is
# what an agent clones and rebases onto.
#
# `start` already does this once, which covers a human who commits between
# sessions. It does not cover the case that actually happens: a person and an
# agent working on the same project at the same time. The person commits in
# their own checkout and leads; the shared repo does not follow, so the agent
# rebases onto a base stale by everything they did, and the first symptom is a
# conflict against work it cannot see. Observed once as a guest running the
# test suite 34 commits behind and reporting a failure already fixed.
#
# A fetch into the bare repo, the same as `vmcav push`: fetch does not run
# pre-receive at all, and refuses a non-fast-forward without a leading `+`. So
# the safe case needs no flag and the unsafe one -- a rewritten base -- cannot
# happen here by accident. That refusal is silent, because a base the human
# rewrote is theirs to resolve with `vmcav push --force` and not something for
# status to nag about on every run.
#
# Only the base. An agent branch in the shared repo is the copy the agent
# pushed, and the checkout's idea of it is at best a stale mirror.
carry_base_to_shared() {
  local branch before after
  branch=$(git -C "$REPO" symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0
  [ -n "$branch" ] || return 0
  case "$branch" in agent-*/*) return 0 ;; esac
  [ -d "$SHARED" ] || return 0
  before=$(git -C "$SHARED" rev-parse --verify --quiet "refs/heads/$branch" 2>/dev/null || true)
  git -C "$SHARED" fetch --quiet "$REPO" \
    "refs/heads/$branch:refs/heads/$branch" 2>/dev/null || return 0
  after=$(git -C "$SHARED" rev-parse --verify --quiet "refs/heads/$branch" 2>/dev/null || true)
  [ "$before" = "$after" ] && return 0
  log "$branch -> shared repo ($(shortrev "$after")), where agents clone it"
}

correct_guest_clock() {
  command -v cave-vm >/dev/null 2>&1 || return 0
  # No pipeline, and that is the whole point.
  #
  # This was `cave-vm ... | grep '^guest clock was' | while read; do log; done`
  # followed by `return 0`. grep exits 1 when it matches nothing, which is the
  # ordinary case -- the clock is usually fine and there is nothing to report
  # -- and under this script's `set -euo pipefail` a bare pipeline returning
  # non-zero ends the script. The `return 0` never ran.
  #
  # So every command that called this died, silently, before printing
  # anything: status and agent both call it before their first line of output.
  # And only where cave-vm is on PATH, because the guard above returns early
  # otherwise -- which is why it never showed up in a guest and did on a host.
  local out line
  out=$(cave-vm guest -state "$STATE_DIR" -if-off-by "${CLOCK_SLACK:-2s}" time 2>&1) || out=""
  while IFS= read -r line; do
    case "$line" in 'guest clock was'*) log "$line" ;; esac
  done <<EOF
$out
EOF
  return 0
}

warn_if_hooks_are_foreign() {
  # Read by cave-vm, which can tell a project whose guard is another tool's
  # from one whose directory is not there any more. This resolved the
  # registration with `readlink -f`, so a moved project gave it an empty path
  # to look under and it reported a missing branch guard -- about a project,
  # not a guard.
  local out line
  out=$(cave-vm projects --state "$STATE_DIR" --guards 2>/dev/null) || true
  while IFS= read -r line; do
    [ -n "$line" ] && log "$line"
  done <<EOF
$out
EOF
  return 0
}

warn_if_guest_is_behind() {
  local was now
  was=$(cat "$STATE_DIR/deployed-from" 2>/dev/null || true)
  now=$(guest_source_rev) || return 0
  # Silent with no record. A guest built before anything recorded one is a
  # one-off state that the next deploy ends, and a permanent warning about a
  # transient condition is worse than the condition.
  [ -n "$was" ] || return 0
  # Dirty first, and regardless of whether the commit still matches: what was
  # built is not in any commit, so nothing here can tell you whether the tree
  # has moved since. Saying "up to date" would be a guess presented as a fact.
  if [ "${was%-dirty}" != "$was" ]; then
    log "the guest was built from uncommitted changes on $(shortrev "${was%-dirty}")"
    log "  nothing records what those were; vmcav deploy to be sure"
    return 0
  fi
  [ "$was" = "$now" ] && return 0
  log "the guest was built from $(shortrev "$was")"
  log "  your checkout is at $(shortrev "${now%-dirty}"); vmcav deploy to catch it up"
}

# What a guest boots is recorded on its own disk, in the system profile it
# activated: the host wrote generation 1 at `image create`, and every
# `nixos-rebuild switch` inside the guest and every `deploy` from outside moves
# it. Read it from there rather than from the host's out-links, so a guest that
# rebuilt itself comes back as itself, and a disk survives a host store that no
# longer has the closure (a gc, a fresh machine, another host entirely).
#
# debugfs reads the filesystem unprivileged and read-only, which is the whole
# reason this is affordable; it is only ever called with the VM stopped, so
# nothing is writing underneath it.
disk_readlink() {
  local out
  out=$(debugfs -R "stat $1" "$DISK" 2>/dev/null \
    | sed -n 's/.*Fast link dest: "\(.*\)"$/\1/p')
  # Past 60 bytes ext4 spills the target into a data block, where stat stops
  # printing it and cat starts.
  [ -n "$out" ] || out=$(debugfs -R "cat $1" "$DISK" 2>/dev/null | tr -d '\n')
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

# Cloud Hypervisor loads the kernel and initrd from the host filesystem, so
# whichever ones the guest's system names have to exist here as files. The host
# store is the fast path, since that is where `image create` and `deploy` left
# them; failing that, copy the guest's own out of the disk.
guest_boot_file() {
  local path="$1" dest
  [ -e "$path" ] && { printf '%s' "$path"; return; }
  dest="$BOOTCACHE/$(basename "$(dirname "$path")")-$(basename "$path")"
  if [ ! -s "$dest" ]; then
    mkdir -p "$BOOTCACHE"
    log "taking $(basename "$path") from the guest disk (the host store lost it)"
    debugfs -R "dump $path $dest" "$DISK" 2>/dev/null || return 1
  fi
  printf '%s' "$dest"
}

do_start() {
  # --for-agent is `vmcav agent` booting the VM on its way to something else.
  # It suppresses only the closing advice, which is advice to create an agent.
  local for_agent=""
  [ "${1:-}" = "--for-agent" ] && { for_agent=1; shift; }
  if is_running; then log "already running (pid $(vm_pid))"; do_status; return 0; fi
  mkdir -p "$STATE_DIR"
  require_tools

  # Boot only. Building is `vmcav image create`; what to boot is the disk's
  # business, and it says so in its system profile.
  [ -f "$DISK" ] || { log "no guest image; create one:  vmcav image create"; return 1; }
  local sys toplevel kpath ipath kernel initrd
  sys=$(disk_readlink /nix/var/nix/profiles/system) || sys=""
  case "$sys" in
    /*) toplevel="$sys" ;;
    # The profile is a symlink to system-N-link beside it, which is the
    # symlink to the store.
    ?*) toplevel=$(disk_readlink "/nix/var/nix/profiles/$sys") || toplevel="" ;;
    *)  toplevel="" ;;
  esac
  kpath=$(disk_readlink "$toplevel/kernel") || kpath=""
  ipath=$(disk_readlink "$toplevel/initrd") || ipath=""
  [ -n "$toplevel" ] && [ -n "$kpath" ] && [ -n "$ipath" ] || {
    log "cannot read a system profile from $DISK; rebuild:  vmcav image reformat"
    return 1; }
  kernel=$(guest_boot_file "$kpath") || return 1
  initrd=$(guest_boot_file "$ipath") || return 1

  # Preconditions are past; from here on start has side effects.
  stage_seed; build_seed_image; start_git_daemon; refresh_shared_base
  crinj_reachable && log "crinj reachable on :$CRINJ_PORT" \
    || log "warning: crinj not reachable on 127.0.0.1:$CRINJ_PORT (no egress/auth for the agent)"
  start_gpg_broker

  # Direct kernel boot: root is the whole of vda (no partition table) and the
  # seed rides on vdb. Everything below this line -- which VMM, how the console
  # is wired, how the vsock plane is built -- is cave-vm's, because that is
  # where it differs between a Linux host and an Apple silicon one.
  local mem; mem=$(config_memory_mb)
  log "guest memory: ${mem} MiB"
  cave-vm start \
    --state "$STATE_DIR" \
    --kernel "$kernel" --initrd "$initrd" --init "$toplevel/init" \
    --disk "$DISK" --seed "$SEEDIMG" \
    --cid "$GUEST_CID" \
    --memory "$mem" \
    --crinj "$CRINJ_ADDR" --git "127.0.0.1:$GIT_PORT" \
    || { log "vm failed to start; see $CONSOLE"; \
         tail -8 "$CONSOLE" 2>/dev/null >&2; stop_gpg_broker; return 1; }
  wait_for_guest || return 1
  # Before anyone attaches, because `/resume` is chosen inside the cave with
  # the host not consulted: a record that is not on disk when claude starts
  # does not exist as far as the agent is concerned.
  restore_sessions
  [ -n "$for_agent" ] || announce_agents
}

# What to do next, which is not the same sentence every time.
#
# A stop leaves an agent's worktree and its home behind -- they are what hold
# its id -- so a guest that has run before comes back holding agents. Saying
# "no agents yet" there was wrong in the way that costs something: it is the
# sentence that makes a human create a second agent beside the first, and the
# first is the one with their conversation in it.
#
# Degrades rather than checks a version. A guest that does not report stopped
# agents reports none, and none is what this said unconditionally before.
announce_agents() {
  # Rendered by cave-vm, for the same reason the roster is: this read back the
  # machine form with awk, and `|| true` around that call made "the guest did
  # not answer" and "the guest holds nothing" the same empty string.
  #
  # Exit 3 is "could not ask", which is not a failure of `start`.
  # Captured rather than piped: `--after-start` exits 3 for "could not ask",
  # and a bare pipeline returning non-zero under `set -euo pipefail` ends the
  # script before the `return 0` below -- which is exactly the shape that made
  # correct_guest_clock kill every command that called it.
  local out line
  out=$(cave-vm agents --state "$STATE_DIR" --after-start 2>/dev/null) || true
  while IFS= read -r line; do
    [ -n "$line" ] && log "$line"
  done <<EOF
$out
EOF
  return 0
}

do_stop() {
  # The guest's login is deliberately not taken here: reformat is the only
  # thing about to destroy the disk it lives on, so it is the only thing that
  # reaches in for it. Session records are different: the guest keeps its copy
  # across a stop, but this is the last moment it can be read, and a VM that
  # does not come back should not take an agent's history with it.
  sync_sessions
  cave-vm stop --state "$STATE_DIR" --disk "$DISK" || true
  stop_git_daemon; stop_gpg_broker
}

# Everything above is definitions, so a test can source this file and call one
# function without a VM, a disk, or a guest. Sourced, the dispatch is skipped.
return 0 2>/dev/null || true

# `vmcav <command> --help`, which is where you ask: at the command, not at the
# top. It used to be read as that command's first argument, so `vmcav agent
# --help` set out to create an agent for a project called --help.
case "${2:-}" in
  -h|--help)
    entry=$(help_for "$1")
    [ -n "$entry" ] || { usage >&2; exit 2; }
    printf '%s\n' "$entry"; exit 0 ;;
esac

case "${1:-help}" in
  start) shift; do_start "$@" ;;
  stop) do_stop ;;
  status) do_status ;;
  agent) shift; do_agent "$@" ;;
  attach) shift; is_running && do_attach "$@" || { log "the vm is not running (vmcav start)"; exit 1; } ;;
  deploy) do_deploy ;;
  review|approve|reject) cave_vm "$@" ;;
  push) shift; do_push "$@" ;;
  init) shift; do_init "$@" ;;
  projects) shift; do_projects "$@" ;;
  remove-project) shift; do_remove_project "$@" ;;
  gc) shift; case "${1:-}" in -y|--yes) do_gc 1 ;; *) do_gc ;; esac ;;
  env) shift; do_env "$@" ;;
  cp) shift; do_cp "$@" ;;
  completion) shift; do_completion "$@" ;;
  # Hidden: the completion scripts' way of asking what exists. Not in the help
  # table, because it is not a thing to run.
  __complete) shift; do_complete "$@" ;;
  shell) shift; do_shell "$@" ;;
  vsock-connect) shift; do_vsock_connect "$@" ;;
  version|--version|-V) do_version ;;
  image)
    shift
    case "${1:-}" in
      create) do_image_create ;;
      reformat) do_image_reformat ;;
      *) echo "usage: vmcav image {create|reformat}" >&2; exit 2 ;;
    esac
    ;;
  -h|--help|help)
    shift
    [ $# -gt 0 ] || { usage; exit 0; }
    entry=$(help_for "$1")
    [ -n "$entry" ] || { usage >&2; exit 2; }
    printf '%s\n' "$entry" ;;
  *) usage >&2; exit 2 ;;
esac

{
  description = "coding-cave: a secure space for agents to write software";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    microvm = {
      url = "github:microvm-nix/microvm.nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    claude-code = {
      url = "github:sadjow/claude-code-nix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, microvm, home-manager, claude-code }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs { inherit system; };

      kernel = import ./lib/kernel.nix { inherit pkgs; };

      nixos = import ./lib/nixos.nix {
        inherit nixpkgs microvm system kernel;
      };

      # See lib/mkCaveEnv.nix. Exposed via legacyPackages because it's a
      # function, not a derivation, and the wrapper flake generated by
      # `cav env build` calls it.
      mkCaveEnv = import ./lib/mkCaveEnv.nix {
        inherit nixpkgs home-manager system;
      };

      # microvm.nix's cloud-hypervisor runner hardcodes
      # "earlyprintk=ttyS0 console=ttyS0" in lib/runners/cloud-hypervisor.nix
      # (kernelConsoleDefault), which bypasses loglevel and prints ~10
      # lines of Linux-version / BIOS-e820 / KASLR before the normal
      # console + loglevel filter come up. Strip via sed since
      # microvm.nix exposes no option to disable.
      patchedRunner = pkgs.runCommand "cav-runner-no-earlyprintk"
        { nativeBuildInputs = [ pkgs.gnused ]; } ''
        mkdir -p $out/bin
        sed 's/earlyprintk=ttyS0 //g' \
          ${nixos.config.microvm.declaredRunner}/bin/microvm-run \
          > $out/bin/microvm-run
        chmod +x $out/bin/microvm-run
      '';

      cav = pkgs.buildGoModule {
        pname = "cav";
        version = "0.0.1";
        src = pkgs.lib.fileset.toSource {
          root = ./.;
          fileset = pkgs.lib.fileset.unions [
            ./go.mod
            ./cmd
          ];
        };
        vendorHash = null;
        env.CGO_ENABLED = "0";
        meta.mainProgram = "cav";
      };

      cavWrapped = pkgs.runCommand "cav-wrapped"
        {
          nativeBuildInputs = [ pkgs.makeWrapper ];
          meta.mainProgram = "cav";
        } ''
        mkdir -p $out/bin
        makeWrapper ${cav}/bin/cav $out/bin/cav \
          --set-default CAV_VIRTIOFSD ${pkgs.virtiofsd}/bin/virtiofsd \
          --set-default CAV_NIXOS_RUNNER ${patchedRunner}/bin/microvm-run \
          --set-default CAV_SCRIPT ${pkgs.util-linux}/bin/script \
          --set-default CAV_FLAKE_SOURCE ${./.} \
          --set-default CAV_NIX ${pkgs.nix}/bin/nix \
          --prefix PATH : ${pkgs.lib.makeBinPath [ pkgs.e2fsprogs ]}
      '';
    in {
      packages.${system} = {
        default = cavWrapped;
        cav = cavWrapped;
        cav-unwrapped = cav;
        kernel = kernel;
        nixos-runner = nixos.config.microvm.declaredRunner;
      };

      # Used by the wrapper flake that `cav env build` generates.
      lib.${system} = { inherit mkCaveEnv; };

      devShells.${system}.default = pkgs.mkShell {
        packages = [
          pkgs.go
          pkgs.gopls
          pkgs.cloud-hypervisor
          pkgs.virtiofsd
        ];
        shellHook = ''
          export CAV_VIRTIOFSD=${pkgs.virtiofsd}/bin/virtiofsd
          export CAV_NIXOS_RUNNER=${nixos.config.microvm.declaredRunner}/bin/microvm-run
          export CAV_SCRIPT=${pkgs.util-linux}/bin/script
          export CAV_NIX=${pkgs.nix}/bin/nix
          export CAV_FLAKE_SOURCE=${./.}
        '';
      };
    };
}

#!/usr/bin/env python3
"""Post-receive hook for shared remote (bare repo).

Tracks the last SHA pushed by each agent so the pre-receive hook can
detect when a force-push would overwrite user commits.
"""

import os
import subprocess
import sys

ZERO_SHA = "0" * 40


def main():
    agent = os.environ.get("CODING_CAVE_AGENT_ID") or None
    if agent is None:
        return

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        _old, new_sha, ref = line.split()
        if not ref.startswith("refs/heads/"):
            continue
        branch = ref[len("refs/heads/"):]
        tip_ref = f"refs/cav/agent-tip/{branch}"
        if new_sha == ZERO_SHA:
            # Branch deleted, remove tracking ref
            subprocess.run(
                ["git", "update-ref", "-d", tip_ref],
                capture_output=True,
            )
        else:
            subprocess.run(
                ["git", "update-ref", tip_ref, new_sha],
                capture_output=True,
            )


if __name__ == "__main__":
    main()
